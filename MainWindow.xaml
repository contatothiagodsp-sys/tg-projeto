<Window x:Class="ThgOptimization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThgOptimization"
        Title="tHg Optimization" Icon="Assets/app.ico" Width="1320" Height="840" MinWidth="1120" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Linha da tela "Sistema": folha = chave/valor; grupo = título + filhos (recursivo) -->
        <DataTemplate DataType="{x:Type local:InfoNode}">
            <StackPanel>
                <Border x:Name="leaf" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="group" Visibility="Collapsed" Margin="0,28,0,0">
                    <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Children}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter TargetName="leaf" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="group" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Placa de vídeo: campo (rótulo em cima, valor embaixo) e seção em cartão com 3 colunas -->
        <DataTemplate x:Key="GpuTile">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12,20,12">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding Value}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GpuSection">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20,16,20,8">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource GpuTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Linha "rótulo ........ valor" (KeyValuePair) -->
        <DataTemplate x:Key="KeyValueRow">
            <Grid Margin="0,4">
                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>

        <!-- Item de diagnóstico (TURBO e SHIELD): ícone, título, achado, conselho, selo e botão de correção -->
        <DataTemplate x:Key="CheckRow">
            <Border x:Name="row" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="20"
                               VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource Muted}"/>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Area}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Faint}"
                                       VerticalAlignment="Center" Margin="12,1,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Found}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Advice}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding TurboSkip}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="130">
                        <Border x:Name="badge" HorizontalAlignment="Right" CornerRadius="10" Padding="8,2" BorderThickness="1"
                                BorderBrush="{DynamicResource LineStrong}">
                            <TextBlock x:Name="badgeText" Text="{Binding LevelText}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Muted}"/>
                        </Border>
                        <Button ToolTip="Aplica a correção sugerida para este item (pode ser desfeita em DESFAZER TUDO)" Style="{StaticResource OutlineButton}" Content="{Binding FixLabel}" Tag="{Binding}" Click="CheckFix_Click"
                                Padding="12,4" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Right"
                                Visibility="{Binding ShowFix, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Ok">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource GoodSoft}"/>
                    <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource GoodSoft}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Good}"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Good}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource BadSoft}"/>
                    <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Bad}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Bad}"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Bad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource WarnSoft}"/>
                    <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource Warn}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Warn}"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Info">
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource Faint}"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Faint}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        
        </DataTemplate>

        <!-- Medidor horizontal: rótulo, valor e barra (Fraction 0..1) -->
        <DataTemplate x:Key="Meter">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0" Background="{DynamicResource Line}">
                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="MonoCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        </Style>
        <Style x:Key="MutedCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="MutedMonoCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Barra de título (marca + página atual + botões da janela) ===== -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="32,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Source="Assets/logo.png" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="TitleWordmark" Source="Assets/thg-wordmark.png" Height="15" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="OPTIMIZATION" FontWeight="Light" FontSize="13" Margin="8,1,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitlePage" Foreground="{DynamicResource Faint}" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnTheme" Style="{StaticResource CaptionButton}" Content="&#xE706;" Click="Theme_Click" ToolTip="Modo claro"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimizar"/>
                <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximizar"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar"/>
            </StackPanel>

            <!-- ===== Menu lateral por categorias (painel arredondado, sempre visível) ===== -->
            <Border x:Name="Sidebar" Grid.Row="1" Margin="16,0,0,16" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20">
                <DockPanel>
                    <!-- Rodapé: aviso de sensores + leitura ao vivo compacta -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                        <Border x:Name="CpuSensorWarn" Visibility="Collapsed" BorderBrush="{DynamicResource Fg}" BorderThickness="1"
                                CornerRadius="12" Padding="12,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sem temperatura e consumo da CPU" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CpuSensorWarnText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <Button ToolTip="Instala o driver de sensores (PawnIO) para ler temperatura, clock e consumo da CPU" Style="{StaticResource PrimaryButton}" Content="CORRIGIR" Padding="12,4" FontSize="11"
                                        Click="BtnFixCpuSensors_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="CPU" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="Bold" Margin="0,4" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideTemp" Grid.Column="1" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,4"/>
                                <TextBlock x:Name="SideLoad" Grid.Column="2" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Text="GPU" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="Bold" Margin="0,4" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideGpuTemp" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,4"/>
                                <TextBlock x:Name="SideGpuLoad" Grid.Row="1" Grid.Column="2" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Text="TESTE" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="Bold" Margin="0,4" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideStress" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="parado" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,4"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SideVersion" Text="tHg Optimization" Foreground="{DynamicResource Faint}" FontSize="11" Margin="4,12,0,0"/>
                    </StackPanel>

                    <!-- Navegação por categorias -->
                    <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                        <StackPanel>
                        <!-- Busca de funções (Ctrl+K) -->
                        <TextBox x:Name="NavSearch" Tag="Buscar função…  (Ctrl+K)" Margin="12,4,12,8" TextChanged="NavSearch_Changed" PreviewKeyDown="NavSearch_KeyDown"/>
                        <StackPanel x:Name="NavSearchResults" Visibility="Collapsed" Margin="0,0,0,8"/>
                        <!-- Áreas (montadas em MainWindow.Areas.cs) -->
                        <StackPanel x:Name="AreaNav" Margin="0,0,0,12" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"
                                    AutomationProperties.Name="Menu principal"/>
                        <!-- Destinos de navegação originais: escondidos, cada aba de área aciona um deles -->
                        <StackPanel x:Name="LegacyNav" Margin="0,0,0,12" Visibility="Collapsed">
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}" Tag="PageDash" Checked="Nav_Checked" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Visão geral" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavTurbo" Style="{StaticResource NavItem}" Tag="PageTurbo" Checked="Nav_Checked">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="TURBO" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="NavTurboScorePill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9" Padding="8,1"
                                            Background="{DynamicResource Hover}" Visibility="Collapsed">
                                        <TextBlock x:Name="NavTurboScore" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="PageSettings" Checked="Nav_Checked" Content="Configurações"/>
                            <RadioButton x:Name="NavComp" Style="{StaticResource NavItem}" Tag="PageComp" Checked="Nav_Checked" Content="Competitivo"/>
                            <RadioButton x:Name="NavShield" Style="{StaticResource NavItem}" Tag="PageShield" Checked="Nav_Checked">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="SHIELD" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="NavShieldScorePill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9" Padding="8,1"
                                            Background="{DynamicResource Hover}" Visibility="Collapsed">
                                        <TextBlock x:Name="NavShieldScore" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="24,12,24,8"/>
                            <ToggleButton x:Name="GrpExplode" Style="{StaticResource NavGroup}" Content="HARDWARE"/>
                            <StackPanel x:Name="GrpExplodeItems" Margin="12,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpExplode, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="PageSystem" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sistema" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSensors" Style="{StaticResource NavItem}" Tag="PageSensors" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensores" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavCpu" Style="{StaticResource NavItem}" Tag="PageCpu" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Processador" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" Tag="PageGpu" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Placa de vídeo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDisks" Style="{StaticResource NavItem}" Tag="PageDisks" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Discos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavEnergy" Style="{StaticResource NavItem}" Tag="PageEnergy" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Energia" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFans" Style="{StaticResource NavItem}" Tag="PageFans" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9CA;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Fans" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLcd" Style="{StaticResource NavItem}" Tag="PageLcd" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Telas LCD e USB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavNet" Style="{StaticResource NavItem}" Tag="PageNet" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE839;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Rede" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpGames" Style="{StaticResource NavGroup}" Content="GAME"/>
                            <StackPanel x:Name="GrpGamesItems" Margin="12,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpGames, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavGameMode" Style="{StaticResource NavItem}" Tag="PageGameMode" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Modo Jogo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLauncher" Style="{StaticResource NavItem}" Tag="PageLauncher" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Biblioteca" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}" Tag="PageGames" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC49;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="FPS estimado" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavBottleneck" Style="{StaticResource NavItem}" Tag="PageBottleneck" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Gargalo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavOverlay" Style="{StaticResource NavItem}" Tag="PageOverlay" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overlay" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpPerf" Style="{StaticResource NavGroup}" Content="DESEMPENHO"/>
                            <StackPanel x:Name="GrpPerfItems" Margin="12,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpPerf, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavBench" Style="{StaticResource NavItem}" Tag="PageBench" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Benchmark" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStress" Style="{StaticResource NavItem}" Tag="PageStress" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stress test" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLatency" Style="{StaticResource NavItem}" Tag="PageLatency" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Teste de engasgos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavOc" Style="{StaticResource NavItem}" Tag="PageOc" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overclock" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpTools" Style="{StaticResource NavGroup}" Content="FERRAMENTAS"/>
                            <StackPanel x:Name="GrpToolsItems" Margin="12,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpTools, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" Tag="PageOptimize" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F3;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Otimização" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavClean" Style="{StaticResource NavItem}" Tag="PageClean" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Limpeza do Windows" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="PageStartup" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inicialização" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="PageApps" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Instalar apps" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDriver" Style="{StaticResource NavItem}" Tag="PageDriver" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drivers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDdu" Style="{StaticResource NavItem}" Tag="PageDdu" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="DDU" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavInteg" Style="{StaticResource NavItem}" Tag="PageInteg" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Integração" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpMaker" Style="{StaticResource NavGroup}" Content="MAKER"/>
                            <StackPanel x:Name="GrpMakerItems" Margin="12,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpMaker, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavMakerPorts" Style="{StaticResource NavItem}" Tag="PageMakerPorts" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Portas COM" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMakerDrv" Style="{StaticResource NavItem}" Tag="PageMakerDrv" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drivers seriais" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <RadioButton x:Name="NavUsb" Style="{StaticResource NavItem}" Tag="PageUsb" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Diagnóstico USB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Conteúdo ===== -->
            <DockPanel Grid.Row="1" Grid.Column="1">
                <!-- Abas da área aberta (MainWindow.Areas.cs) -->
                <Border x:Name="AreaTabsBar" DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="24,0,24,0" Visibility="Collapsed">
                    <WrapPanel x:Name="AreaTabs"/>
                </Border>
            <Grid>

                <!-- ===== VISÃO GERAL (painel) ===== -->
                <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,8,24,20">

                        <!-- Linha 1: gráfico grande + desempenho -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorder}" Padding="24,20">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="DashChartLabel" Text="CPU · TEMPERATURA" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                            <Border x:Name="DashDeltaPill" HorizontalAlignment="Left" CornerRadius="10" Padding="8,4" Background="{DynamicResource Hover}">
                                                <TextBlock x:Name="DashChartDelta" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource Mono}"/>
                                            </Border>
                                            <TextBlock x:Name="DashChartValue" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                            <TextBlock Text="GPU" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="DashChartValue2" Text="—" FontFamily="{StaticResource Mono}" FontSize="24"
                                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,16,0,8">
                                        <StackPanel x:Name="DashRangePanel" Orientation="Horizontal" Margin="0,0,20,0">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="1 MIN" Tag="60" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="5 MIN" Tag="300" IsChecked="True" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="15 MIN" Tag="900" Checked="DashOption_Checked"/>
                                        </StackPanel>
                                        <StackPanel x:Name="DashMetricPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Temperatura" Tag="temp" IsChecked="True" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Carga" Tag="load" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Consumo" Tag="power" Checked="DashOption_Checked"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Canvas x:Name="DashChart" Height="210" ClipToBounds="True" SizeChanged="DashChart_SizeChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Rectangle Width="14" Height="2" Fill="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                        <Line X1="0" X2="14" Stroke="{DynamicResource Muted}" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Desempenho (como o "Total Balance" da referência) -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24,20">
                                <DockPanel>
                                    <Button ToolTip="Abre o Benchmark para medir CPU, GPU, memória e disco" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="RODAR BENCHMARK" Margin="0,16,0,0"
                                            Padding="20,12" Click="DashBench_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="DESEMPENHO · BENCH" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBlock x:Name="DashScore" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}"/>
                                            <Border x:Name="DashScorePill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="8,4"
                                                    Background="Transparent">
                                                <TextBlock x:Name="DashScoreDelta" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource Mono}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="DashScoreSub" Text="multi-core · nenhum teste ainda" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,0"/>
                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,16"/>
                                        <ItemsControl x:Name="DashScores" ItemTemplate="{StaticResource KeyValueRow}"/>
                                        <!-- Caixa interna, como o widget de troca da referência -->
                                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                                                Padding="16,4" Margin="0,16,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,12">
                                                    <TextBlock Text="CPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock x:Name="DashCpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="52,0,0,0"/>
                                                </Grid>
                                                <Border Height="1" Background="{DynamicResource Line}"/>
                                                <Grid Margin="0,12">
                                                    <TextBlock Text="GPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock x:Name="DashGpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="52,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Linha 2: tabela de componentes -->
                        <Border Style="{StaticResource CardBorder}" Padding="24,16,24,8" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="COMPONENTE" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="TEMPERATURA" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="2" Text="CARGA" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="3" Text="CLOCK" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="4" Text="CONSUMO / USO" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="5" Text="VER" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl x:Name="DashComponents">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="56"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                            <TextBlock Text="{Binding Model}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Temp}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Load}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Clock}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Power}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="5" Style="{StaticResource CaptionButton}" Width="30" Height="30" Content="&#xE72A;"
                                                            HorizontalAlignment="Right" Tag="{Binding Target}" Click="DashGo_Click" ToolTip="Abrir detalhes"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Linha 3: anéis de memória, eventos e saúde -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Anéis concêntricos (como o "Annual Profit" da referência) -->
                            <Border Style="{StaticResource CardBorder}" Padding="24,20">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA E DISCO" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DashMemHero" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}" FontSize="30"/>
                                    <TextBlock x:Name="DashMemSub" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,8"/>
                                    <Canvas x:Name="DashRings" Width="190" Height="190" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                    <ItemsControl x:Name="DashRingLegend">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Eventos recentes (como "Transactions") -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24,20">
                                <StackPanel>
                                    <TextBlock Text="Eventos recentes" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="DashEventsEmpty" Text="Nada ainda. Benchmarks, testes e dispositivos conectados aparecem aqui."
                                               Foreground="{DynamicResource Faint}" TextWrapping="Wrap" FontSize="12"/>
                                    <ItemsControl x:Name="DashEvents">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Fg}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Ink}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding When}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Saúde do PC (como "Rewards"): lista de verificação + ação -->
                            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="24,20">
                                <DockPanel>
                                    <Button ToolTip="Abre o TURBO: diagnóstico com nota e correções para jogos" x:Name="DashAction" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="ABRIR O TURBO" Padding="20,12"
                                            Margin="0,16,0,0" Click="DashOptimize_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="O que resolver" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DashScoresLine" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="DashHealth">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12" Background="Transparent"
                                                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="DashCheck_Click" ToolTip="{Binding Hint}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="chk" Text="&#xE739;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Faint}"
                                                                       Margin="0,0,12,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter TargetName="chk" Property="Text" Value="&#xE73D;"/>
                                                        <Setter TargetName="chk" Property="Foreground" Value="{DynamicResource Good}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter TargetName="chk" Property="Text" Value="&#xEA39;"/>
                                                        <Setter TargetName="chk" Property="Foreground" Value="{DynamicResource Bad}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== SISTEMA ===== -->
                <Grid x:Name="PageSystem" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,24">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Sistema" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="SystemSub" Text="Hardware e software detectados" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BtnReport" Style="{StaticResource OutlineButton}" Content="EXPORTAR RELATÓRIO" Padding="16,8"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnReport_Click"
                                ToolTip="Salva um relatório (HTML ou JSON) com sistema, RAM, discos, GPU, sensores e benchmarks. Números de série são omitidos."/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="InfoCategories" ItemContainerStyle="{StaticResource ListNavItem}"
                                 SelectionChanged="InfoCategories_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="28,8,28,24">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="InfoTitle" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/>

                                    <!-- Unidades (só em Armazenamento): anel de cheio/vazio por letra -->
                                    <StackPanel x:Name="DrivesPanel" Visibility="Collapsed" Margin="0,4,0,8">
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="UNIDADES" Style="{StaticResource Label}" Margin="0"/>
                                            <TextBlock x:Name="DrivesSummary" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ItemsControl x:Name="DriveCards">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="16,16" Margin="0,0,12,12"
                                                            Background="{DynamicResource Bg}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Anel: trilha cinza = vazio, arco branco = usado -->
                                                            <Grid Width="84" Height="84" Margin="0,0,16,0" VerticalAlignment="Center">
                                                                <Ellipse Width="72" Height="72" Stroke="{DynamicResource Line}" StrokeThickness="8"/>
                                                                <Path Data="{Binding UsedArc}" Stroke="{DynamicResource Fg}" StrokeThickness="8" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                                                                <TextBlock Text="{Binding UsedPercent}" FontFamily="{StaticResource Mono}" FontSize="16"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Sizes}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="DISCOS FÍSICOS" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                                    </StackPanel>

                                    <ItemsControl x:Name="InfoDetails"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== DISCOS (saúde) ===== -->
                <ScrollViewer x:Name="PageDisks" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Discos" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="DiskHealthStatus" Text="Saúde, desgaste e temperatura de cada disco" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Lê de novo os discos, o espaço livre e a saúde (SMART)" x:Name="BtnDiskRefresh" Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="20,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnDiskRefresh_Click"/>
                        </Grid>

                        <ItemsControl x:Name="DiskCards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Margin="0,0,132,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource Fg}" BorderThickness="1" Padding="12,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Fg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Reasons}" TextWrapping="Wrap" Margin="0,12,0,12"/>
                                            <ItemsControl ItemsSource="{Binding Metrics}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,16,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                            Os dados vêm do Windows (S.M.A.R.T. e API de armazenamento) e dos sensores do disco. Pendrives e alguns HDs externos
                            não informam saúde. O veredito é uma estimativa: faça backup de qualquer disco com aviso, não só dos críticos.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== ENERGIA (bateria e fonte) ===== -->
                <ScrollViewer x:Name="PageEnergy" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Energia" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="EnergyStatus" Text="Bateria, fonte de energia e consumo" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Lê de novo a bateria, a fonte e o plano de energia" x:Name="BtnEnergyRefresh" Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="20,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnEnergyRefresh_Click"/>
                        </Grid>
                        <ItemsControl x:Name="EnergyCards" ItemTemplate="{StaticResource CardTemplate}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                            Os dados vêm do Windows (WMI). Alguns notebooks não informam ciclos de carga ou a capacidade de projeto.
                            O consumo mostrado vem dos sensores de CPU e GPU, não da fonte (PSU) do PC.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== REDE (diagnóstico de lag) ===== -->
                <ScrollViewer x:Name="PageNet" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Rede" Style="{StaticResource H1}"/>
                                <TextBlock Text="Descubra se o lag vem do seu PC, do Wi-Fi ou do provedor" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Mede ping, perda de pacotes e velocidade da sua conexão" x:Name="BtnNetTest" Style="{StaticResource PrimaryButton}" Content="TESTAR" Padding="24,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnNetTest_Click"/>
                        </Grid>
                        <Grid Height="3" Margin="0,0,0,8" Background="{DynamicResource Line}">
                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="NetProgress" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="NetStatus" Text="Pronto. O teste leva cerca de 30 segundos." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="NetCards" ItemTemplate="{StaticResource CardTemplate}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                            O teste envia pacotes de ping ao roteador e aos DNS públicos 1.1.1.1 e 8.8.8.8 e baixa/envia dados de teste do servidor público
                            speed.cloudflare.com (cerca de 100 MB no total). Feche downloads, streaming e jogos antes para um resultado fiel.
                        </TextBlock>

                        <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0" Padding="24,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="SERVIDORES DE JOGOS E DNS" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button ToolTip="Volta para os servidores DNS que você usava antes do tHg" x:Name="BtnDnsRestore" Style="{StaticResource OutlineButton}" Content="VOLTAR AO DNS ANTERIOR" Padding="12,4"
                                                FontSize="11" Margin="0,0,8,0" Click="BtnDnsRestore_Click"/>
                                        <Button ToolTip="Mede o ping até os servidores dos jogos e serviços mais usados" x:Name="BtnServers" Style="{StaticResource PrimaryButton}" Content="TESTAR" Padding="16,4" FontSize="11"
                                                Click="BtnServers_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ServersStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Mede o tempo até datacenters onde ficam servidores de jogos e qual DNS responde mais rápido na sua internet."/>
                                <ItemsControl x:Name="ServerList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <StackPanel Margin="0,0,220,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="DNS (TEMPO PARA ACHAR O ENDEREÇO DE UM SITE OU JOGO)" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                                <ItemsControl x:Name="DnsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Server, Mode=OneWay}" Foreground="{DynamicResource Faint}" FontFamily="{StaticResource Mono}"/></TextBlock>
                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <Button ToolTip="Usa este servidor DNS no adaptador de rede ativo" Style="{StaticResource OutlineButton}" Content="USAR" Padding="12,4" FontSize="11" Tag="{Binding}" Click="BtnUseDns_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== DRIVER ===== -->
                <ScrollViewer x:Name="PageDriver" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,192,0">
                                <TextBlock Text="DRIVER" Style="{StaticResource H1}"/>
                                <TextBlock Text="Verifique, baixe e instale drivers · NVIDIA e AMD automáticos, fabricantes pela página oficial" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Compara os drivers instalados com as versões mais novas da NVIDIA, AMD, Intel e do fabricante da placa-mãe" x:Name="BtnDrvScan" Style="{StaticResource PrimaryButton}" Content="VERIFICAR TUDO" Padding="20,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnDrvScan_Click"/>
                        </Grid>
                        <Grid Height="3" Margin="0,0,0,8" Background="{DynamicResource Line}">
                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="DrvProgress" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DrvStatus" Text="Clique em VERIFICAR TUDO." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="DrvGpus">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="{Binding GpuName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0">
                                                    <Run Text="Instalado: "/><Run Text="{Binding Installed, Mode=OneWay}"/>
                                                    <Run Text="  ·  Mais recente: "/><Run Text="{Binding Latest, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox x:Name="DrvStudio" Content="Driver Studio (criação) em vez de Game Ready" Margin="0,16,0,0"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button ToolTip="Baixa o driver mais novo do site oficial, confere a assinatura e abre o instalador" x:Name="BtnDrvInstall" Style="{StaticResource PrimaryButton}" Content="BAIXAR E INSTALAR" Padding="20,8" Margin="0,0,12,8" Click="BtnDrvInstall_Click" IsEnabled="False"/>
                                    <Button ToolTip="Abre a página de drivers do fabricante da placa de vídeo no navegador" x:Name="BtnDrvGpuPage" Style="{StaticResource OutlineButton}" Content="ABRIR PÁGINA OFICIAL" Padding="20,8" Margin="0,0,12,8" Click="BtnDrvGpuPage_Click"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                                    NVIDIA: o instalador é baixado do servidor oficial, a assinatura digital é conferida e um ponto de restauração é criado antes de abrir.
                                    AMD: o programa procura o instalador na página oficial do seu modelo (RX série 4000 a 9000); se o site bloquear, use ABRIR PÁGINA OFICIAL. Intel: só a página oficial.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PLACA-MÃE / FABRICANTE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DrvBoard" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <Button ToolTip="Abre a página de suporte da sua placa-mãe no navegador" x:Name="BtnDrvBoardPage" Style="{StaticResource OutlineButton}" Content="ABRIR SUPORTE DO FABRICANTE" Padding="20,8" Margin="0,16,0,8"
                                        HorizontalAlignment="Left" Click="BtnDrvBoardPage_Click" IsEnabled="False"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                                    ASUS, MSI, Gigabyte e outros não têm API pública de versões. Abrimos o suporte oficial do fabricante detectado
                                    (chipset, áudio, rede, BIOS). Se a página não abrir no seu modelo, digite o modelo mostrado acima na busca do site.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="WINDOWS UPDATE (DRIVERS CERTIFICADOS)" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DrvWuList" Margin="0,12,0,0" TextWrapping="Wrap" Text="Ainda não pesquisado."/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button ToolTip="Procura drivers opcionais no Windows Update" x:Name="BtnDrvWuSearch" Style="{StaticResource OutlineButton}" Content="PROCURAR" Padding="20,8" Margin="0,0,12,8" Click="BtnDrvWuSearch_Click"/>
                                    <Button ToolTip="Instala todos os drivers encontrados no Windows Update (pode pedir para reiniciar)" x:Name="BtnDrvWuInstall" Style="{StaticResource PrimaryButton}" Content="INSTALAR TODOS" Padding="20,8" Margin="0,0,12,8" Click="BtnDrvWuInstall_Click" IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="BACKUP DOS DRIVERS" Style="{StaticResource Label}"/>
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                           Text="Exporta todos os drivers de terceiros para Documentos\ThgOptimization-Drivers. Útil antes de formatar ou de trocar um driver."/>
                                <Button ToolTip="Copia todos os drivers instalados para uma pasta, para reinstalar depois de formatar" x:Name="BtnDrvBackup" Style="{StaticResource OutlineButton}" Content="FAZER BACKUP" Padding="20,8" Margin="0,16,0,0"
                                        HorizontalAlignment="Left" Click="BtnDrvBackup_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DRIVERS INSTALADOS" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="DrvList" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Device}" TextWrapping="Wrap"/>
                                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="11">
                                                        <Run Text="{Binding Class, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Vendor, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11" TextAlignment="Right" Margin="12,0,0,0">
                                                    <Run Text="{Binding Version, Mode=OneWay}"/><LineBreak/><Run Text="{Binding Date, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SignedText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== INTEGRAÇÃO (iluminação) ===== -->
                <ScrollViewer x:Name="PageInteg" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,192,0">
                                <TextBlock Text="INTEGRAÇÃO" Style="{StaticResource H1}"/>
                                <TextBlock Text="Iluminação e efeitos do PC · Corsair iCUE, OpenRGB (MSI, Gigabyte, ASUS...) e Razer Chroma (em teste)" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Conecta Razer, Corsair, OpenRGB e os demais sistemas de iluminação encontrados" x:Name="BtnLightConnect" Style="{StaticResource OutlineButton}" Content="CONECTAR TUDO" Padding="20,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnLightConnect_Click"/>
                        </Grid>

                        <Border x:Name="RgbConflictBox" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="Collapsed"
                                BorderBrush="{DynamicResource Warn}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CONFLITO COM OUTRO PROGRAMA DE RGB" Style="{StaticResource Label}" Foreground="{DynamicResource Warn}"/>
                                <TextBlock x:Name="RgbConflictText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button ToolTip="Fecha o SignalRGB e o L-Connect, que prendem os dispositivos, e reconecta o RGB" x:Name="BtnRgbConflict" Style="{StaticResource OutlineButton}" Content="Fechar SignalRGB para liberar os dispositivos"
                                        HorizontalAlignment="Left" Padding="20,8" Margin="0,12,0,0" Click="BtnRgbConflict_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="INTEGRAÇÕES" Style="{StaticResource Label}"/>

                                <TextBlock Text="Corsair iCUE / iCUE LINK" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                <TextBlock x:Name="LightStatus" Text="Aguardando…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                <Button ToolTip="Baixa e instala o SDK da Corsair, necessário para controlar o iCUE" x:Name="BtnLightSdk" Style="{StaticResource OutlineButton}" Content="BAIXAR O SDK DA CORSAIR" Visibility="Collapsed"
                                        HorizontalAlignment="Left" Padding="20,8" Margin="0,12,0,0" Click="BtnLightSdk_Click"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                    Requer o iCUE aberto com o SDK ativado nas configurações (manual, dentro do iCUE). A DLL do SDK é baixada pelo botão acima.
                                </TextBlock>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="OpenRGB · MSI Mystic Light, Gigabyte RGB Fusion, ASUS Aura, RAM, Razer, Logitech e outras" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="OrgbStatus" Text="Aguardando…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                        <Button ToolTip="Abre o OpenRGB com o servidor ligado (ou baixa e instala a versão oficial, se ainda não tiver), para o tHg controlar placa-mãe, memória e periféricos" x:Name="BtnOrgbOpen" Style="{StaticResource OutlineButton}" Content="ABRIR O OPENRGB"
                                                HorizontalAlignment="Left" Padding="20,8" Margin="0,12,0,0" Click="BtnOrgbOpen_Click"/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            A MSI, a Gigabyte, a ASUS e a ASRock não oferecem SDK público; o OpenRGB (gratuito, openrgb.org) conversa com os controladores delas. O botão acima baixa e instala o OpenRGB oficial sem abrir o navegador.
                                            Ele precisa estar aberto com o servidor SDK ligado, e o MSI Center, o Armoury Crate e o RGB Fusion devem estar fechados.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Razer Chroma" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="RazerStatus" Text="Aguardando…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            Requer o Razer Synapse instalado e aberto. Controla cada categoria (teclado, mouse, headset...) com uma cor só.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Iluminação Dinâmica do Windows · Logitech, Razer, ASUS e outros compatíveis" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DynStatus" Text="Aguardando…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                        <Button ToolTip="Abre Configurações → Personalização → Iluminação dinâmica do Windows" x:Name="BtnDynSettings" Style="{StaticResource OutlineButton}" Content="ABRIR ILUMINAÇÃO DINÂMICA"
                                                HorizontalAlignment="Left" Padding="20,8" Margin="0,12,0,0" Click="BtnDynSettings_Click"/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            Não precisa de programa do fabricante: o próprio Windows conversa com os aparelhos. O Windows só entrega as luzes ao tHg
                                            enquanto a janela dele está em primeiro plano; minimizado, volta o efeito escolhido nas configurações do Windows.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DISPOSITIVOS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="LightDevicesHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="LightDevices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="EFEITO" Style="{StaticResource Label}"/>
                                <WrapPanel x:Name="LightFxPanel" Margin="0,4,0,12">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Cor fixa" Tag="static" IsChecked="True" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Respiração" Tag="breath" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Arco-íris" Tag="rainbow" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Temperatura da CPU" Tag="cpu" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Temperatura da GPU" Tag="gpu" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Carga da CPU" Tag="load" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Apagar" Tag="off" Checked="LightFx_Checked"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16">
                                    Temperatura e carga mudam a cor sozinhas (azul = frio/ocioso, verde, amarelo, vermelho = quente/carga alta).
                                    Cor fixa e Respiração usam a cor escolhida abaixo.
                                </TextBlock>

                                <TextBlock Text="COR" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                    <Border x:Name="LightPreview" Width="46" Height="46" Margin="0,0,16,0" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" VerticalAlignment="Top"/>
                                    <WrapPanel x:Name="LightSwatches" Width="360"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,2"><TextBlock Text="VERMELHO" Style="{StaticResource Label}"/></Grid>
                                <Slider x:Name="LightR" Minimum="0" Maximum="255" Value="255" ValueChanged="LightColor_Changed"/>
                                <Grid Margin="0,8,0,2"><TextBlock Text="VERDE" Style="{StaticResource Label}"/></Grid>
                                <Slider x:Name="LightG" Minimum="0" Maximum="255" Value="255" ValueChanged="LightColor_Changed"/>
                                <Grid Margin="0,8,0,2"><TextBlock Text="AZUL" Style="{StaticResource Label}"/></Grid>
                                <Slider x:Name="LightB" Minimum="0" Maximum="255" Value="255" ValueChanged="LightColor_Changed"/>

                                <Grid Margin="0,16,0,2">
                                    <TextBlock Text="BRILHO" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LightBrightText" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LightBright" Minimum="0" Maximum="100" Value="100" ValueChanged="LightColor_Changed"/>
                                <Grid Margin="0,8,0,2">
                                    <TextBlock Text="VELOCIDADE (RESPIRAÇÃO E ARCO-ÍRIS)" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LightSpeedText" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LightSpeed" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LightColor_Changed"/>

                                <CheckBox x:Name="LightExclusive" Content="Controle exclusivo (Corsair: se não mudar nada, desmarque e tente de novo)" IsChecked="True" Margin="0,16,0,0"/>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button ToolTip="Liga o controle de iluminação pelo tHg com as cores escolhidas" x:Name="BtnLightRun" Style="{StaticResource PrimaryButton}" Content="ATIVAR CONTROLE"
                                            Padding="24,12" Margin="0,0,16,0" Click="BtnLightRun_Click"/>
                                    <TextBlock x:Name="LightLive" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontFamily="{StaticResource Mono}"/>
                                </WrapPanel>
                                <TextBlock x:Name="LightRunHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource Label}"/>
                                <TextBox x:Name="LightDiag" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                         MinHeight="90" MaxHeight="260" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                    Se as luzes não mudarem, copie este quadro e me envie.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== GAME (inicializador) ===== -->
                <Grid x:Name="PageLauncher" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de jogos -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="GAME" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="LGameCount" Text="Procurando seus jogos…" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBox x:Name="LGameSearch" Tag="Buscar jogo…" TextChanged="LGameSearch_Changed" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button ToolTip="Procura de novo jogos instalados na Steam, Epic, Riot, EA, Ubisoft, GOG e Battle.net" x:Name="BtnScanGames" Style="{StaticResource OutlineButton}" Content="ATUALIZAR LISTA" Padding="16,8" Margin="0,0,8,0" Click="BtnScanGames_Click"/>
                                <Button ToolTip="Adiciona à biblioteca um jogo que não foi encontrado sozinho" Style="{StaticResource OutlineButton}" Content="+ ADICIONAR .EXE" Padding="16,8" Click="BtnAddExe_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="LGameList" Grid.Row="2" ItemContainerStyle="{StaticResource ListNavItem}" SelectionChanged="LGameList_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Detalhes do jogo -->
                    <TextBlock x:Name="LEmpty" Grid.Column="2" Text="Escolha um jogo na lista." Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,60,0,0"/>
                    <ScrollViewer x:Name="LDetail" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,8">
                                <StackPanel Margin="0,0,200,0">
                                    <TextBlock x:Name="LTitle" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LSub" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button ToolTip="Abre o jogo com o perfil escolhido" x:Name="BtnPlay" Style="{StaticResource PrimaryButton}" Content="JOGAR" Padding="40,16" FontSize="16"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnPlay_Click"/>
                            </Grid>
                            <TextBlock x:Name="LStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <!-- Desempenho -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="DESEMPENHO" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Prioridade do processo" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                    <WrapPanel x:Name="LPriorityPanel" Margin="0,4,0,12">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LPriority" Content="Normal" Tag="normal" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LPriority" Content="Acima do normal" Tag="above" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LPriority" Content="Alta" Tag="high" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <CheckBox x:Name="LChkPlan" Content="Plano de energia Alto desempenho enquanto joga (volta ao normal depois)" Margin="0,0,0,12" Click="LProfile_Changed"/>
                                    <CheckBox x:Name="LChkGpu" Content="Forçar a placa de vídeo dedicada (configuração gráfica do Windows)" Margin="0,0,0,12" Click="LProfile_Changed"/>
                                    <CheckBox x:Name="LChkFso" Content="Desativar otimizações de tela cheia do Windows" Margin="0,0,0,12" Click="LProfile_Changed"/>
                                    <TextBlock x:Name="LExeText" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button ToolTip="Escolhe o executável do jogo" Style="{StaticResource OutlineButton}" Content="ESCOLHER O .EXE" Padding="16,8" Margin="0,0,8,0" Click="BtnPickExe_Click"/>
                                        <Button ToolTip="Preenche o perfil com as opções que mais rendem FPS neste PC" Style="{StaticResource OutlineButton}" Content="PERFIL PARA MAIS FPS" Padding="16,8" Click="BtnRecommended_Click"/>
                                    </WrapPanel>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                        Prioridade e plano de energia valem só durante o jogo. As opções de GPU e tela cheia são gravadas para o .exe do jogo no Windows
                                        (o programa descobre o .exe sozinho; se errar, escolha o certo).
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Gráficos -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="GRÁFICOS (ARGUMENTOS DE INICIALIZAÇÃO)" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Modo de janela" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                    <WrapPanel x:Name="LModePanel" Margin="0,4,0,12">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Padrão do jogo" Tag="default" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Tela cheia" Tag="full" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Sem bordas" Tag="borderless" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Janela" Tag="window" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Resolução" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel x:Name="LResPanel" Margin="0,4,0,12">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="Padrão" Tag="default" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="1280x720" Tag="1280x720" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="1920x1080" Tag="1920x1080" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="2560x1440" Tag="2560x1440" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="3840x2160" Tag="3840x2160" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Taxa de atualização (Hz)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel x:Name="LHzPanel" Margin="0,4,0,12">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="Padrão" Tag="0" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="60" Tag="60" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="120" Tag="120" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="144" Tag="144" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="165" Tag="165" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="240" Tag="240" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Tipo de argumento (depende do jogo)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel x:Name="LStylePanel" Margin="0,4,0,12">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LStyle" Content="Source / CS2" Tag="source" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LStyle" Content="Unity" Tag="unity" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LStyle" Content="Unreal" Tag="unreal" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Extras" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <TextBox x:Name="LExtra" Tag="ex.: -novid -high +fps_max 0" Margin="0,4,0,8" TextChanged="LExtra_Changed"/>
                                    <WrapPanel x:Name="LExtraPresets" Margin="0,0,0,12"/>
                                    <TextBlock Text="LINHA FINAL" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LPreview" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                    <StackPanel x:Name="LSteamBox" Visibility="Collapsed">
                                        <TextBlock x:Name="LSteamNow" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Button ToolTip="Grava as opções de inicialização deste perfil nas propriedades do jogo na Steam" x:Name="BtnSteamApply" Style="{StaticResource PrimaryButton}" Content="APLICAR NAS OPÇÕES DA STEAM"
                                                HorizontalAlignment="Left" Padding="20,8" Click="BtnSteamApply_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LGfxNote" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Programas auxiliares -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="PROGRAMAS AUXILIARES" Style="{StaticResource Label}"/>
                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12">
                                        Ferramentas de terceiros que abrem antes do jogo (monitoramento, comandos, mixer de áudio, script...). O GAME as abre
                                        sozinho ao clicar em JOGAR e pode fechá-las junto com o jogo. Nada é escrito nas opções da Steam.
                                    </TextBlock>
                                    <ItemsControl x:Name="LHelpers">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,92,0"/>
                                                    <Button ToolTip="Tira o programa da lista de programas abertos junto com o jogo" Style="{StaticResource OutlineButton}" Content="REMOVER" Padding="12,4" FontSize="11" Tag="{Binding}"
                                                            HorizontalAlignment="Right" Click="BtnRemoveHelper_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button ToolTip="Abre um programa junto com o jogo (Discord, overlay, macro…)" Style="{StaticResource OutlineButton}" Content="+ ADICIONAR PROGRAMA" Padding="16,8" Margin="0,0,16,0" Click="BtnAddHelper_Click"/>
                                        <CheckBox x:Name="LHelperClose" Content="Fechar junto com o jogo" IsChecked="True" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== SENSORES ===== -->
                <Grid x:Name="PageSensors" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Sensores" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="StatusText" Text="Lendo sensores…" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <TextBox x:Name="SensorSearch" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Tag="Buscar sensor ou hardware…" TextChanged="SensorSearch_Changed"/>
                    </Grid>
                    <WrapPanel x:Name="CategoryChips" Grid.Row="1" Margin="0,0,0,16"/>
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8,16,8,8">
                        <DataGrid x:Name="SensorGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserResizeColumns="False">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="12,24,0,8"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SENSOR" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Category}" Width="130" ElementStyle="{StaticResource MutedCell}"/>
                                <DataGridTextColumn Header="VALOR" Binding="{Binding Value}" Width="130" ElementStyle="{StaticResource MonoCell}"/>
                                <DataGridTextColumn Header="MÍN." Binding="{Binding Min}" Width="120" ElementStyle="{StaticResource MutedMonoCell}"/>
                                <DataGridTextColumn Header="MÁX." Binding="{Binding Max}" Width="120" ElementStyle="{StaticResource MutedMonoCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ===== PROCESSADOR ===== -->
                <Grid x:Name="PageCpu" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Processador" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="CpuPageSub" Text="Ficha lida do Windows e sensores em tempo real · sem leitura = —" Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SensorWarning}" Foreground="{DynamicResource Warn}" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SensorWarning}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding VendorBadge}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="30" FontWeight="Black" Foreground="{DynamicResource Faint}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20,16,20,12">
                                    <StackPanel>
                                        <TextBlock Text="FICHA" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding StaticRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" Margin="0,0,140,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="260"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="20,16,20,16">
                                    <StackPanel>
                                        <TextBlock Text="ENERGIA E NÚCLEOS" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,4">
                                            <TextBlock Text="Plano de energia ativo" Foreground="{DynamicResource Muted}"/>
                                            <TextBlock Text="{Binding Plan}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="Core parking" Foreground="{DynamicResource Muted}" Margin="0,8,0,2"/>
                                        <TextBlock Text="{Binding ParkingSetting}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ParkingNow}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button ToolTip="Abre o Benchmark para medir a CPU" Style="{StaticResource PrimaryButton}" Content="BENCHMARK DE CPU" Padding="20,8" Margin="0,0,8,8" Command="{Binding GoBenchCommand}"/>
                                            <Button ToolTip="Abre o Stress test para testar temperatura e estabilidade da CPU" Style="{StaticResource OutlineButton}" Content="STRESS TEST" Padding="20,8" Margin="0,0,8,8" Command="{Binding GoStressCommand}"/>
                                            <Button Style="{StaticResource OutlineButton}" Content="AJUSTES DE NÚCLEOS" Padding="20,8" Margin="0,0,8,8" Command="{Binding GoCoresCommand}"
                                                    ToolTip="Core parking e plano de energia (Otimizar → Ajustes) · núcleos preferidos do jogo (Modo Jogo)"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,16,12,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="AO VIVO" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding LiveRows}" DockPanel.Dock="Top" Margin="0,0,8,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid DockPanel.Dock="Top" Margin="0,0,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NÚCLEO" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="1" Text="CLOCK" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="2" Text="TEMP." Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="3" Text="USO (POR THREAD)" Style="{StaticResource Label}"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Cores}" Margin="0,0,8,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Core}" Foreground="{DynamicResource Muted}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Clock}" FontFamily="{StaticResource Mono}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Temp}" FontFamily="{StaticResource Mono}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Load}" FontFamily="{StaticResource Mono}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== PLACA DE VÍDEO ===== -->
                <Grid x:Name="PageGpu" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Placa de vídeo" Style="{StaticResource H1}"/>
                            <TextBlock Text="Especificações completas e sensores em tempo real" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <WrapPanel x:Name="GpuChips" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Destaque -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="GpuName" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GpuSubtitle" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="GpuVendor" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="30" FontWeight="Black" Foreground="{DynamicResource Faint}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <ItemsControl x:Name="GpuSections" ItemTemplate="{StaticResource GpuSection}"/>
                        </ScrollViewer>

                        <!-- Sensores (equivalente à aba Sensors do GPU-Z) -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,16,12,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="SENSORES AO VIVO" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="GpuExtras" DockPanel.Dock="Top" Margin="0,0,8,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="GpuLive" Margin="0,0,8,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <TextBlock>
                                                            <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource Faint}"/>
                                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== JOGOS ===== -->
                <Grid x:Name="PageGames" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Jogos" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="GamesSub" Text="FPS esperado no seu PC" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <TextBox x:Name="GameSearch" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Tag="Buscar jogo…" TextChanged="GameSearch_Changed"/>
                    </Grid>

                    <!-- Configuração -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <WrapPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="RESOLUÇÃO" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="GameResPanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameRes" Content="1080p" Tag="1920x1080" Margin="0,0,8,0" IsChecked="True" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameRes" Content="1440p" Tag="2560x1440" Margin="0,0,8,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameRes" Content="4K" Tag="3840x2160" Margin="0" Checked="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="GamePresetBox" Margin="0,0,32,0">
                                <TextBlock Text="GRÁFICOS" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="GamePresetPanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Baixo" Tag="Baixo" Margin="0,0,8,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Médio" Tag="Médio" Margin="0,0,8,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Alto" Tag="Alto" Margin="0,0,8,0" IsChecked="True" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Ultra" Tag="Ultra" Margin="0" Checked="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="UPSCALING (DLSS / FSR)" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="GameUpscalePanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameUp" Content="Nativo" Tag="Native" Margin="0,0,8,0" IsChecked="True" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameUp" Content="Qualidade" Tag="Quality" Margin="0,0,8,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameUp" Content="Desempenho" Tag="Performance" Margin="0" Checked="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Fonte dos dados -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="GameSourceTitle" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GameSourceText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Grid Width="240" Margin="0,0,8,0">
                                    <PasswordBox x:Name="ApiKeyBox" ToolTip="Chave da API HowManyFPS" PasswordChanged="ApiKeyBox_Changed"/>
                                    <TextBlock x:Name="ApiKeyHint" Text="Chave da API HowManyFPS" Foreground="{DynamicResource Faint}"
                                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Button ToolTip="Salva a chave do HowManyFPS para buscar FPS medidos de verdade na estimativa" x:Name="BtnApiKey" Style="{StaticResource OutlineButton}" Content="SALVAR CHAVE" Padding="16,8"
                                        Click="BtnApiKey_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cartões dos jogos -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl x:Name="GameList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12" Padding="16,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,12"/>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FpsText}" FontFamily="{StaticResource Mono}" FontSize="30"/>
                                                    <TextBlock Text=" FPS" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Rating}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                                            </Grid>
                                            <!-- Barra: escala até 240 FPS -->
                                            <Grid Height="3" Margin="0,8,0,8" Background="{DynamicResource Line}">
                                                <Border Background="{DynamicResource Fg}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Bar}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="{Binding LowText}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ===== GARGALO ===== -->
                <ScrollViewer x:Name="PageBottleneck" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Detector de gargalo" Style="{StaticResource H1}"/>
                            <TextBlock Text="Descobre o que está limitando o seu FPS: GPU, CPU, memória ou temperatura" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Equilíbrio teórico -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="EQUILÍBRIO DO HARDWARE" Style="{StaticResource Label}"/>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock x:Name="BnCpuName" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="BnGpuName" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Escala: esquerda = GPU fraca para a CPU; centro = equilibrado; direita = CPU fraca para a GPU -->
                                    <Grid Height="22" Margin="0,8,0,4">
                                        <Border Height="4" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                                        <Border Width="2" Height="10" Background="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Canvas x:Name="BnBalanceCanvas" SizeChanged="BnBalanceCanvas_SizeChanged">
                                            <Ellipse x:Name="BnBalanceDot" Width="14" Height="14" Fill="{DynamicResource Fg}" Canvas.Top="4"/>
                                        </Canvas>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="limita a GPU" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                        <TextBlock Text="equilibrado" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock Text="limita a CPU" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock x:Name="BnBalanceText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <TextBlock Text="Estimativa pelo desempenho relativo típico; o detector ao vivo mostra a realidade de cada jogo."
                                               Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Veredito ao vivo -->
                            <Border x:Name="BnLiveCard" Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock x:Name="BnLiveLabel" Text="AGORA" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="BnLiveTitle" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BnLiveGame" Foreground="{DynamicResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BnLiveAdvice" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Leituras ao vivo -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20,16,20,8">
                            <StackPanel>
                                <TextBlock Text="LEITURAS AO VIVO" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="BnMeters" ItemTemplate="{StaticResource Meter}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,24,0"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sessão -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ANÁLISE DE SESSÃO" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Clique em iniciar, abra o jogo e jogue normalmente. Ao final você recebe o diagnóstico."
                                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel x:Name="BnDurationPanel" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BnDur" Content="1 min" Tag="1" Margin="0,0,8,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BnDur" Content="3 min" Tag="3" Margin="0,0,8,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BnDur" Content="5 min" Tag="5" Margin="0"/>
                                        </StackPanel>
                                        <Button ToolTip="Grava a sessão de jogo e mostra se a CPU ou a GPU está limitando o FPS" x:Name="BtnBnSession" Style="{StaticResource PrimaryButton}" Content="INICIAR ANÁLISE" Click="BtnBnSession_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="BnSessionStatus" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
                                <StackPanel x:Name="BnResult" Visibility="Collapsed" Margin="0,16,0,0">
                                    <TextBlock x:Name="BnResultTitle" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BnResultSummary" Foreground="{DynamicResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="BnDistribution" ItemTemplate="{StaticResource Meter}"/>
                                    <TextBlock x:Name="BnResultAdvice" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== OVERLAY ===== -->
                <ScrollViewer x:Name="PageOverlay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Overlay" Style="{StaticResource H1}"/>
                            <TextBlock Text="FPS, frametime e sensores por cima do jogo" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel>
                                    <CheckBox x:Name="ChkOverlay" Content="Mostrar overlay" FontSize="16" Checked="ChkOverlay_Changed" Unchecked="ChkOverlay_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="48,12,0,0">
                                        <TextBlock Text="ATALHO" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button x:Name="HotkeyLabel" Style="{StaticResource OutlineButton}" Content="Ctrl + Shift + O" Padding="16,8"
                                                FontFamily="{StaticResource Mono}" FontSize="12" Click="HotkeyLabel_Click" ToolTip="Clique e pressione o novo atalho"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource Muted}" Margin="48,8,0,0" TextWrapping="Wrap"
                                               Text="Liga e desliga o overlay, inclusive dentro do jogo e com o tHg na bandeja. Clique no atalho para trocar."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <WrapPanel>
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock Text="POSIÇÃO" Style="{StaticResource Label}"/>
                                    <StackPanel x:Name="OvCornerPanel" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Superior esquerdo" Tag="TL" Margin="0,0,8,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Superior direito" Tag="TR" Margin="0,0,8,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Inferior esquerdo" Tag="BL" Margin="0,0,8,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Inferior direito" Tag="BR" Margin="0" Checked="OvOption_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TAMANHO" Style="{StaticResource Label}"/>
                                    <StackPanel x:Name="OvScalePanel" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvScale" Content="Pequeno" Tag="0.85" Margin="0,0,8,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvScale" Content="Médio" Tag="1" Margin="0,0,8,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvScale" Content="Grande" Tag="1.3" Margin="0" Checked="OvOption_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="O QUE MOSTRAR" Style="{StaticResource Label}"/>
                                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button ToolTip="Overlay só com o contador de FPS" Style="{StaticResource OutlineButton}" Content="SÓ FPS" Tag="min" Padding="12,4" FontSize="11" Margin="0,0,8,0" Click="OvPreset_Click"/>
                                        <Button ToolTip="Overlay com FPS, temperaturas e uso de CPU/GPU" Style="{StaticResource OutlineButton}" Content="PADRÃO" Tag="default" Padding="12,4" FontSize="11" Margin="0,0,8,0" Click="OvPreset_Click"/>
                                        <Button ToolTip="Overlay com todas as informações disponíveis" Style="{StaticResource OutlineButton}" Content="TUDO" Tag="all" Padding="12,4" FontSize="11" Click="OvPreset_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                    Marque o que quer ver por cima do jogo; a mudança vale na hora e fica salva. Cada componente vira uma linha
                                    (GPU, VRAM, CPU, RAM) só com os itens escolhidos. Clock da memória, hotspot e ventoinha dependem da placa;
                                    o limitador (PerfCap) é só NVIDIA. Clock e temperatura da CPU precisam do app como administrador.
                                </TextBlock>
                                <StackPanel x:Name="OvItemsPanel"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="DETECÇÃO DE FPS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OvStatus" FontSize="16"/>
                                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0">
                                    O FPS é medido pelo rastreamento de eventos do Windows (ETW), a mesma técnica do PresentMon:
                                    nada é injetado no jogo, então é seguro com anti-cheat. Funciona com DirectX 9 a 12; jogos em
                                    Vulkan/OpenGL só aparecem se o driver apresentar via DXGI. O overlay aparece em tela cheia
                                    "sem bordas" e na maioria dos jogos DX11/12 em tela cheia, mas não em tela cheia exclusiva antiga.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== BENCH ===== -->
                <Grid x:Name="PageBench" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="BENCH" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="BenchSub" Text="Benchmark de CPU por renderização 3D (path tracing), no mesmo princípio do Cinebench" Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <!-- Seletor de teste -->
                    <WrapPanel x:Name="BenchTestPanel" Grid.Row="1" Margin="0,0,0,16">
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Render (CPU)" Tag="render" IsChecked="True" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Cena de jogo (GPU)" Tag="gpu" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Ray tracing (GPU)" Tag="rt" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Simulação de jogo (CPU)" Tag="sim" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Memória e carregamento" Tag="mem" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Disco" Tag="disk" Checked="BenchTest_Checked"/>
                    </WrapPanel>

                    <Grid x:Name="BenchPanelRender" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Render -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Background="#050505">
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="960" Height="540">
                                            <Image x:Name="BenchImage" Width="960" Height="540" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Canvas x:Name="BenchBuckets" Width="960" Height="540"/>
                                            <TextBlock x:Name="BenchIdle" Text="Pressione INICIAR para renderizar a cena"
                                                       Foreground="{DynamicResource Faint}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <Grid Height="3" Margin="0,12,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="BenchProgress" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="BenchStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="BenchElapsed" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Painel lateral -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TESTE" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="BenchModePanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchMode" Content="Multi-core" Tag="mt"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchMode" Content="Single-core" Tag="st"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchMode" Content="Ambos" Tag="both" IsChecked="True"/>
                                        </WrapPanel>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                                        <WrapPanel x:Name="BenchDurationPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchDur" Content="1 passada" Tag="0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchDur" Content="Mínimo 10 min" Tag="10"/>
                                        </WrapPanel>
                                        <Button ToolTip="Inicia o benchmark de CPU (um e todos os núcleos)" x:Name="BtnBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnBench_Click"/>
                                        <TextBlock x:Name="BenchHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <Grid>
                                            <TextBlock Text="Multi-core" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="BenchMt" Text="—" FontFamily="{StaticResource Mono}" FontSize="30"/>
                                                <TextBlock Text=" pts" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="Single-core" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="BenchSt" Text="—" FontFamily="{StaticResource Mono}" FontSize="30"/>
                                                <TextBlock Text=" pts" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="BenchRatio" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="DURANTE O TESTE" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="BenchLive">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="BenchHistoryEmpty" Text="Nenhum resultado ainda." Foreground="{DynamicResource Faint}"/>
                                        <ItemsControl x:Name="BenchHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Cena de jogo (GPU) ===== -->
                    <Grid x:Name="BenchPanelGpu" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="VALE · CENA DE JOGO" Style="{StaticResource Label}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                                    Sobrevoo de um vale com terreno gerado por ruído fractal (~500 mil triângulos), 40 mil árvores
                                    por instancing, sombras em tempo real (mapa 4096² com bordas suaves), água com ondas, neblina,
                                    céu e pós-processamento HDR. A câmera segue um trajeto fixo pelo tempo e a resolução é fixa:
                                    o trabalho é o mesmo em qualquer PC. A cena abre numa janela própria; ESC cancela.
                                </TextBlock>
                                <Grid Margin="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FPS AGORA" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="GbFpsNow" Text="—" FontFamily="{StaticResource Mono}" FontSize="44"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="GPU" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="GbGpuNow" Text="—" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="3" Margin="0,16,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="GbProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="GbStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUÇÃO" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="GbResPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbRes" Content="1080p" Tag="1920x1080" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbRes" Content="1440p" Tag="2560x1440"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbRes" Content="4K" Tag="3840x2160"/>
                                        </WrapPanel>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                                        <WrapPanel x:Name="GbDurPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbDur" Content="30 s" Tag="30"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbDur" Content="60 s" Tag="60" IsChecked="True"/>
                                        </WrapPanel>
                                        <Button ToolTip="Inicia o benchmark de placa de vídeo" x:Name="BtnGpuBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnGpuBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="GbResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="GbHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Ray tracing (GPU, DXR 1.1) ===== -->
                    <Grid x:Name="BenchPanelRt" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="CIDADE DE OBJETOS · RAY TRACING POR HARDWARE" Style="{StaticResource Label}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                                            Direct3D 12 com DXR 1.1: usa os núcleos de ray tracing da placa (RTX 20 ou mais nova, Radeon RX 6000
                                            ou mais nova, Intel Arc). 4 mil objetos em materiais fosco, metal e espelho; por pixel, path tracing com
                                            sombras suaves, oclusão de ambiente, reflexos de reflexos e iluminação indireta. A estrutura de
                                            aceleração é refeita a cada frame, com objetos girando, como nos jogos. Abre numa janela própria; ESC cancela.
                                        </TextBlock>
                                        <Grid Margin="0,24,0,0">
                                            <StackPanel>
                                                <TextBlock Text="FPS AGORA" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="RtFpsNow" Text="—" FontFamily="{StaticResource Mono}" FontSize="44"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="ETAPA" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="RtPhase" Text="—" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Height="3" Margin="0,16,0,8" Background="{DynamicResource Line}">
                                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="RtProgress" ScaleX="0"/></Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="RtStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="24,20">
                                    <StackPanel>
                                        <TextBlock Text="COMO COMPARAR COM CONFIANÇA" Style="{StaticResource Label}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12">
                                            O teste aquece a placa sem medir (o clock e a temperatura se estabilizam) e depois roda 3 passadas
                                            iguais. A nota usa a MEDIANA das passadas, e a variação entre elas mostra se o resultado é
                                            confiável (abaixo de 3%). O tempo de cada frame vem do relógio da própria GPU. Compare só resultados
                                            com a mesma resolução e o mesmo preset, com o PC na tomada, sem outros programas pesados abertos
                                            e com o mesmo driver. A cena é sempre a mesma (sementes fixas), em qualquer PC.
                                        </TextBlock>
                                        <TextBlock Text="REFERÊNCIA MEDIDA" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12">
                                            AMD Radeon RX 9070 · Alta 1440p · modo Padrão: 878 pts (87,8 FPS, 1% low 77), variação 0,5%.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUÇÃO" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="RtResPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtRes" Content="1080p" Tag="1920x1080"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtRes" Content="1440p" Tag="2560x1440" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtRes" Content="4K" Tag="3840x2160"/>
                                        </WrapPanel>
                                        <TextBlock Text="PRESET" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                                        <WrapPanel x:Name="RtPresetPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtPreset" Content="Normal" Tag="normal"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtPreset" Content="Alta" Tag="alta" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtPreset" Content="Extrema" Tag="extrema"/>
                                        </WrapPanel>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            Normal: 2 amostras e 2 rebatidas por pixel · Alta: 4 e 3 · Extrema: 8 e 4.
                                        </TextBlock>
                                        <TextBlock Text="MODO" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                                        <WrapPanel x:Name="RtModePanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtMode" Content="Padrão" Tag="std" IsChecked="True"
                                                         ToolTip="Aquece 20 s e mede 3 passadas de 30 s (~2 min). Use para comparar."/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtMode" Content="Rápido" Tag="quick"
                                                         ToolTip="Aquece 5 s e mede 3 passadas de 10 s (~35 s). Só para uma ideia rápida."/>
                                        </WrapPanel>
                                        <Button ToolTip="Inicia o benchmark de ray tracing" x:Name="BtnRtBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnRtBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="RtVerdict" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="RtResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="RtHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Simulação de jogo (CPU) ===== -->
                    <Grid x:Name="BenchPanelSim" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <Border Background="#050505" HorizontalAlignment="Center">
                                        <Image x:Name="SimImage" Width="440" Height="440" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <TextBlock x:Name="SimIdle" Text="30 mil unidades em batalha" Foreground="{DynamicResource Faint}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Height="3" Margin="0,12,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="SimProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="SimStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="SimFpsNow" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12">
                                            Simula o trabalho de CPU de um jogo: a thread principal monta a grade espacial, roda a lógica
                                            e prepara o desenho; as outras threads calculam física, colisão e IA de 30 mil unidades.
                                            A nota é quantos frames por segundo a CPU aguenta.
                                        </TextBlock>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="SimDurPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="SimDur" Content="20 s" Tag="20" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="SimDur" Content="60 s" Tag="60"/>
                                        </WrapPanel>
                                        <Button ToolTip="Inicia a simulação de cena de jogo (CPU + memória)" x:Name="BtnSimBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnSimBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="SimResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="SimHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Memória e carregamento ===== -->
                    <Grid x:Name="BenchPanelMem" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="RESULTADOS" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="MemResult" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,140,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Height="3" Margin="0,16,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="MemProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="MemStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12">
                                            Mede a latência e a banda da RAM e simula o carregamento de um mapa: um pacote de 512 MB e
                                            mil arquivos de 64 KB, lidos do disco sem o cache do Windows. Os arquivos de teste ficam na
                                            pasta temporária e são apagados no final.
                                        </TextBlock>
                                        <Button ToolTip="Mede largura de banda e latência da memória RAM" x:Name="BtnMemBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Click="BtnMemBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="MemHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Disco ===== -->
                    <Grid x:Name="BenchPanelDisk" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="RESULTADOS" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="DiskResult" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,172,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Height="3" Margin="0,16,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="DiskProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DiskStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="UNIDADE" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="DiskDrivePanel"/>
                                        <TextBlock Text="TAMANHO DO TESTE" Style="{StaticResource Label}" Margin="0,12,0,8"/>
                                        <WrapPanel x:Name="DiskSizePanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DiskSize" Content="512 MB" Tag="512"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DiskSize" Content="1 GB" Tag="1024" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DiskSize" Content="4 GB" Tag="4096"/>
                                        </WrapPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,12">
                                            Mede leitura e escrita sequenciais e acessos aleatórios de 4 KB, direto no disco (sem o cache do Windows).
                                            Grava um arquivo temporário na unidade escolhida e o apaga no final. Feche outros programas pesados antes.
                                        </TextBlock>
                                        <Button ToolTip="Mede leitura e escrita sequencial e aleatória do disco escolhido" x:Name="BtnDiskBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Click="BtnDiskBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="DiskHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===== OTIMIZA ===== -->
                <ScrollViewer x:Name="PageOptimize" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="OTIMIZA" Style="{StaticResource H1}"/>
                            <TextBlock Text="Libera memória, fecha o que atrapalha e ajusta o Windows para jogos" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- Botão principal -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <Grid>
                                        <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="OptRamText" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Height="6" Background="{DynamicResource Line}" Margin="0,0,0,12">
                                        <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="OptRamBar" ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
                                        Um clique: limpa a memória em espera e fecha os programas marcados na lista abaixo.
                                        Use antes de abrir um jogo.
                                    </TextBlock>
                                    <TextBlock x:Name="OptResult" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                                <Button ToolTip="Aplica os ajustes do Windows marcados nesta página (todos podem ser desfeitos)" x:Name="BtnOptimize" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="OTIMIZA"
                                        FontSize="16" Padding="36,16" VerticalAlignment="Center" Click="BtnOptimize_Click"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Programas -->
                            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="PROGRAMAS PARA FECHAR" Style="{StaticResource Label}"/>
                                        <Button ToolTip="Lê de novo os programas abertos e o uso de memória" Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="12,4" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRefreshApps_Click"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                        Marcados = seguros de fechar durante o jogo. Programas com janela recebem o pedido de
                                        fechar (como clicar no X) e não são forçados, para não perder nada não salvo.
                                    </TextBlock>
                                    <ItemsControl x:Name="OptApps">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontFamily="{StaticResource Mono}"
                                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Ajustes do Windows -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="AJUSTES DO WINDOWS PARA JOGOS" Style="{StaticResource Label}"/>
                                        <Button ToolTip="Volta todos os ajustes do Windows para como estavam antes do tHg" Style="{StaticResource OutlineButton}" Content="RESTAURAR ORIGINAIS" Padding="12,4" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRestoreTweaks_Click"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                        O interruptor mostra o estado atual e aplica na hora. O valor original é guardado na primeira
                                        alteração. Não mexemos em segurança (Defender, Integridade de Memória, UAC, Windows Update).
                                    </TextBlock>
                                    <ItemsControl x:Name="OptTweaks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsOn, Mode=OneWay}" Tag="{Binding}" Click="Tweak_Click"
                                                                  VerticalAlignment="Top" Margin="0,1,12,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,112,0"/>
                                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding Effect}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== TURBO (diagnóstico de PC gamer + correção em um clique) ===== -->
                <ScrollViewer x:Name="PageTurbo" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="TURBO" Style="{StaticResource H1}"/>
                            <TextBlock Text="Diagnóstico completo de PC gamer: hardware, BIOS, Windows e rede, com correção em um clique" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- Nota + ações -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,32,0" MinWidth="170" VerticalAlignment="Center">
                                    <TextBlock Text="NOTA GAMER" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TurboScore" Text="—" FontSize="64" FontWeight="Bold" FontFamily="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Fg}"/>
                                        <TextBlock Text="/100" FontSize="16" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,16"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TurboVerdict" Text="Analisando o PC…" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="220"/>
                                    <TextBlock x:Name="TurboSummary" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="220" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="POR ÁREA" Style="{StaticResource Label}"/>
                                    <ItemsControl x:Name="TurboAreas" ItemTemplate="{StaticResource Meter}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="32,0,0,0" VerticalAlignment="Center" Width="230">
                                    <Button ToolTip="Aplica todas as correções seguras encontradas no diagnóstico" x:Name="BtnTurbo" Style="{StaticResource PrimaryButton}" Content="TURBO: CORRIGIR TUDO"
                                            FontSize="16" Padding="20,16" Click="BtnTurbo_Click"/>
                                    <CheckBox x:Name="TurboRestorePoint" IsChecked="True" Margin="0,12,0,0">
                                        <TextBlock Text="Criar ponto de restauração antes" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    </CheckBox>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button ToolTip="Faz o diagnóstico completo de novo e atualiza a nota" x:Name="BtnTurboScan" Style="{StaticResource OutlineButton}" Content="ANALISAR" Padding="8,8" FontSize="11"
                                                Click="BtnTurboScan_Click"/>
                                        <Button ToolTip="Desfaz tudo que o TURBO alterou" Grid.Column="2" Style="{StaticResource OutlineButton}" Content="DESFAZER TUDO" Padding="8,8" FontSize="11"
                                                Click="BtnTurboUndo_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TurboResult" TextWrapping="Wrap" Margin="2,0,0,16" Visibility="Collapsed"/>

                        <!-- Filtros -->
                        <WrapPanel x:Name="TurboFilters" Margin="0,0,0,8">
                            <RadioButton Style="{StaticResource Chip}" GroupName="TurboFilter" Tag="problems" Content="Para corrigir" IsChecked="True" Checked="TurboFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="TurboFilter" Tag="all" Content="Tudo" Checked="TurboFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="TurboFilter" Tag="HARDWARE" Content="Hardware" Checked="TurboFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="TurboFilter" Tag="BIOS" Content="BIOS" Checked="TurboFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="TurboFilter" Tag="WINDOWS" Content="Windows" Checked="TurboFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="TurboFilter" Tag="REDE" Content="Rede" Checked="TurboFilter_Checked"/>
                        </WrapPanel>

                        <!-- Itens do diagnóstico -->
                        <Border Style="{StaticResource CardBorder}" Padding="20,8">
                            <StackPanel>
                                <TextBlock x:Name="TurboEmpty" Text="Nenhum item aqui." Foreground="{DynamicResource Muted}" Margin="0,16" Visibility="Collapsed"/>
                                <ItemsControl x:Name="TurboList" ItemTemplate="{StaticResource CheckRow}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0">
                            O TURBO só aplica ajustes documentados e reversíveis, guarda o valor original de cada um e nunca desliga proteções
                            (Defender, Integridade de Memória, UAC, Windows Update). Itens de BIOS e de montagem trazem o passo a passo
                            para a sua placa-mãe. "Desfazer tudo" volta o Windows e a taxa dos monitores para como estavam.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Competitivo: latência, rede/input, perfis por jogo e baixo nível ===== -->
                <ScrollViewer x:Name="PageComp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <DataTemplate x:Key="CompTweakTemplate">
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsOn, Mode=OneWay}" Tag="{Binding}" Click="CompTweak_Click"
                                              VerticalAlignment="Top" Margin="0,1,12,0" AutomationProperties.Name="{Binding Title}"/>
                                    <StackPanel Grid.Column="1">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource Warn}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="Impacto: " FontWeight="SemiBold"/><Run Text="{Binding Effect, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="980" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Competitivo" Style="{StaticResource H1}"/>
                                <TextBlock Text="Latência, 1% low e ajustes para Valorant, CS2, LoL e GTA V / FiveM" Style="{StaticResource Sub}"/>
                            </StackPanel>
                            <Button ToolTip="Volta todos os ajustes desta página (e a afinidade de interrupções) para como estavam antes do tHg"
                                    Style="{StaticResource OutlineButton}" Content="DESFAZER TUDO" Padding="12,4" FontSize="11"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnCompRestore_Click"/>
                        </Grid>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16">
                            Cada ajuste guarda o valor original antes da primeira mudança: desmarcar volta ao que era, e "Desfazer tudo" volta a página inteira.
                            Nenhum ajuste daqui desliga o UAC, o Defender ou o anti-cheat. Meça antes e depois com Desempenho → Engasgos.
                        </TextBlock>

                        <!-- Módulo 1 -->
                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}">
                            <StackPanel>
                                <TextBlock Text="1 · LATÊNCIA E FRAMETIMES" Style="{StaticResource Label}"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="Frametime regular = 1% low mais perto da média. Ajustes de timer, de composição da tela e do agendador multimídia."/>
                                <ItemsControl x:Name="CompLatency" ItemTemplate="{StaticResource CompTweakTemplate}"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="SystemResponsiveness fica em 10: segundo a documentação da Microsoft, 0 é tratado como 10, então gravar 0 não muda nada."/>
                            </StackPanel>
                        </Border>

                        <!-- Módulo 2 -->
                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}">
                            <StackPanel>
                                <TextBlock Text="2 · REDE E INPUT" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="CompNet" ItemTemplate="{StaticResource CompTweakTemplate}" Margin="0,8,0,0"/>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <StackPanel>
                                        <TextBlock Text="Afinidade de interrupções (IRQ)" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Prende as interrupções da placa de vídeo ou de rede a um núcleo escolhido (política IrqPolicySpecifiedProcessors, a mesma da ferramenta da Microsoft)."/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8">
                                            <Run Text="Impacto: " FontWeight="SemiBold"/><Run Text="tira o trabalho do driver do núcleo onde roda o jogo, o que pode reduzir picos de latência de DPC e melhorar o 1% low. Evite a CPU 0 (o Windows já coloca muita coisa nela) e prefira um núcleo físico (em CPUs com SMT, os números pares). Escolha errada pode piorar: meça antes e depois. Precisa reiniciar."/>
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DISPOSITIVO" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                                <ListBox x:Name="CompIrqDevice" ItemContainerStyle="{StaticResource ListNavItem}" DisplayMemberPath="Label"
                                                         SelectionChanged="CompIrqDevice_Changed" AutomationProperties.Name="Dispositivo"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="NÚCLEO" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                                <ListBox x:Name="CompIrqCore" ItemContainerStyle="{StaticResource ListNavItem}" MaxHeight="220"
                                                         AutomationProperties.Name="Núcleo da CPU">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button ToolTip="Grava o núcleo escolhido para o dispositivo marcado (vale depois de reiniciar)" Style="{StaticResource PrimaryButton}"
                                                    Content="APLICAR" Padding="16,6" FontSize="12" Click="BtnIrqApply_Click"/>
                                            <TextBlock x:Name="CompIrqStatus" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Taxa de polling do mouse" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Mede quantas vezes por segundo o mouse informa a posição (125, 500, 1000 Hz…), lendo o movimento bruto (Raw Input)."/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8">
                                            <Run Text="Por que não tem um botão &quot;1000 Hz&quot;: " FontWeight="SemiBold"/><Run Text="quem define a taxa é o próprio mouse (firmware). No Windows 10/11 não existe valor de registro que mude isso; os &quot;tweaks&quot; que prometem 1000 Hz trocam o driver USB por um não assinado, o que o anti-cheat do Valorant e do FACEIT bloqueia. Aqui você confere a taxa real e o tHg diz onde mudar."/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnPolling" ToolTip="Durante 5 segundos, conta os relatórios do mouse enquanto você o mexe" Style="{StaticResource PrimaryButton}"
                                                    Content="MEDIR" Padding="16,6" FontSize="12" Click="BtnPolling_Click"/>
                                            <TextBlock x:Name="CompPolling" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="700"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Módulo 3 -->
                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}">
                            <StackPanel>
                                <TextBlock Text="3 · PERFIS POR JOGO" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="CompGames" ItemTemplate="{StaticResource CompTweakTemplate}" Margin="0,8,0,0"/>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <StackPanel>
                                        <TextBlock Text="CS2: limpar o cache de shaders da Valve" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Apaga a pasta steamapps\shadercache\730 em todas as bibliotecas da Steam."/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8">
                                            <Run Text="Impacto: " FontWeight="SemiBold"/><Run Text="resolve engasgos que aparecem depois de atualizar o driver de vídeo ou o jogo (cache velho ou corrompido). As primeiras partidas depois de limpar podem engasgar enquanto o cache é refeito."/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="Apaga o cache de shaders do CS2 (feche o jogo e a Steam antes)" Style="{StaticResource OutlineButton}"
                                                    Content="LIMPAR CACHE" Padding="16,6" FontSize="12" Click="BtnCs2Shaders_Click"/>
                                            <TextBlock x:Name="CompCs2Shader" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"
                                           Text="UAC no League of Legends: o tHg não reduz o UAC. Baixar o UAC deixa qualquer programa virar administrador sem aviso, e o cliente da Riot funciona normalmente com ele ligado. Se o LoL pedir permissão toda vez, reinstale pelo instalador oficial da Riot."/>
                            </StackPanel>
                        </Border>

                        <!-- Módulo 4 -->
                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}">
                            <StackPanel>
                                <TextBlock Text="4 · SISTEMA (BAIXO NÍVEL)" Style="{StaticResource Label}"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="Mudam a inicialização, a memória e as interrupções do Windows. Todos precisam reiniciar e todos voltam com o desmarcar."/>
                                <ItemsControl x:Name="CompSystem" ItemTemplate="{StaticResource CompTweakTemplate}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Configurações do app (antes só no menu da bandeja) ===== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="880" HorizontalAlignment="Left">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Configurações" Style="{StaticResource H1}"/>
                            <TextBlock Text="Aparência, inicialização com o Windows, bandeja e atualizações do tHg Optimization" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="APARÊNCIA" Style="{StaticResource Label}"/>
                                <TextBlock Text="Tema do aplicativo" FontSize="{StaticResource FontBodyStrong}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                    <RadioButton x:Name="SetThemeSystem" Style="{StaticResource Chip}" GroupName="SetTheme" Tag="system" Content="Igual ao Windows" Click="SetTheme_Click"
                                                 ToolTip="Segue Configurações → Personalização → Cores e troca sozinho quando você muda lá"/>
                                    <RadioButton x:Name="SetThemeDark" Style="{StaticResource Chip}" GroupName="SetTheme" Tag="dark" Content="Escuro" Click="SetTheme_Click"
                                                 ToolTip="Sempre escuro (preto puro)"/>
                                    <RadioButton x:Name="SetThemeLight" Style="{StaticResource Chip}" GroupName="SetTheme" Tag="light" Content="Claro" Click="SetTheme_Click"
                                                 ToolTip="Sempre claro"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="INICIALIZAÇÃO E BANDEJA" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SetStartWin" Click="SetStartWin_Click" Margin="0,4,0,8"
                                          ToolTip="Cria uma tarefa agendada que abre o tHg na bandeja ao entrar no Windows (necessária para o Modo Jogo automático e as telas LCD)">
                                    <TextBlock Text="Iniciar com o Windows (abre escondido na bandeja, perto do relógio)" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="SetCloseTray" Click="SetCloseTray_Click"
                                          ToolTip="Desligado: o X fecha o tHg de vez, e o Modo Jogo, o overlay e as telas LCD param">
                                    <TextBlock Text="O botão fechar (X) manda para a bandeja em vez de sair" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="SetVersion" FontSize="{StaticResource FontBodyStrong}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="SetAutoUpdate" Click="SetAutoUpdate_Click" Margin="0,0,0,12"
                                          ToolTip="Consulta o GitHub ao abrir o app; a atualização só é instalada quando você confirmar">
                                    <TextBlock Text="Procurar atualizações automaticamente" TextWrapping="Wrap"/>
                                </CheckBox>
                                <Button x:Name="SetCheckUpdate" Style="{StaticResource OutlineButton}" Content="PROCURAR AGORA" Padding="16,8" HorizontalAlignment="Left"
                                        Click="SetCheckUpdate_Click" ToolTip="Consulta agora se existe uma versão mais nova do tHg Optimization"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="{StaticResource SectionGap}" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="DADOS E SUPORTE" Style="{StaticResource Label}"/>
                                <TextBlock Text="Configurações, histórico de jogos, backups dos ajustes e o registro de falhas ficam numa pasta protegida do seu usuário."
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource OutlineButton}" Content="ABRIR PASTA DE DADOS" Padding="16,8" Margin="0,0,8,8" Click="SetOpenData_Click"
                                            ToolTip="Abre no Explorador a pasta com as configurações e o registro de falhas"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="RELATAR UM PROBLEMA" Padding="16,8" Margin="0,0,8,8" Click="SetReport_Click"
                                            ToolTip="Abre uma página do GitHub para descrever o problema (você revisa antes de enviar)"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== SHIELD (segurança do Windows) ===== -->
                <ScrollViewer x:Name="PageShield" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="SHIELD" Style="{StaticResource H1}"/>
                            <TextBlock Text="Segurança do Windows para quem joga: antivírus, firewall, contas, rede, BIOS e golpes comuns entre gamers" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,32,0" MinWidth="170" VerticalAlignment="Center">
                                    <TextBlock Text="NOTA DE SEGURANÇA" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ShieldScore" Text="—" FontSize="64" FontWeight="Bold" FontFamily="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Fg}"/>
                                        <TextBlock Text="/100" FontSize="16" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,16"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ShieldVerdict" Text="Verificando…" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="220"/>
                                    <TextBlock x:Name="ShieldSummary" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="220" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="POR ÁREA" Style="{StaticResource Label}"/>
                                    <ItemsControl x:Name="ShieldAreas" ItemTemplate="{StaticResource Meter}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="32,0,0,0" VerticalAlignment="Center" Width="230">
                                    <Button ToolTip="Aplica todas as proteções recomendadas do Windows" x:Name="BtnShield" Style="{StaticResource PrimaryButton}" Content="BLINDAR" FontSize="16" Padding="20,16"
                                            Click="BtnShield_Click"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button ToolTip="Verifica de novo antivírus, firewall, Secure Boot, TPM e demais proteções" x:Name="BtnShieldScan" Style="{StaticResource OutlineButton}" Content="VERIFICAR" Padding="8,8" FontSize="11"
                                                Click="BtnShieldScan_Click"/>
                                        <Button ToolTip="Desfaz as proteções aplicadas pelo SHIELD" Grid.Column="2" Style="{StaticResource OutlineButton}" Content="DESFAZER" Padding="8,8" FontSize="11"
                                                Click="BtnShieldUndo_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ShieldResult" TextWrapping="Wrap" Margin="2,0,0,16" Visibility="Collapsed"/>

                        <WrapPanel Margin="0,0,0,8">
                            <RadioButton Style="{StaticResource Chip}" GroupName="ShieldFilter" Tag="problems" Content="Para corrigir" IsChecked="True" Checked="ShieldFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="ShieldFilter" Tag="all" Content="Tudo" Checked="ShieldFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="ShieldFilter" Tag="PROTEÇÃO" Content="Proteção" Checked="ShieldFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="ShieldFilter" Tag="SISTEMA" Content="Sistema" Checked="ShieldFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="ShieldFilter" Tag="REDE" Content="Rede" Checked="ShieldFilter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="ShieldFilter" Tag="CONTAS E JOGOS" Content="Contas e jogos" Checked="ShieldFilter_Checked"/>
                        </WrapPanel>

                        <Border Style="{StaticResource CardBorder}" Padding="20,8">
                            <StackPanel>
                                <TextBlock x:Name="ShieldEmpty" Text="Nenhum item aqui." Foreground="{DynamicResource Muted}" Margin="0,16" Visibility="Collapsed"/>
                                <ItemsControl x:Name="ShieldList" ItemTemplate="{StaticResource CheckRow}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0">
                            O SHIELD só liga proteções; nunca desliga nada. Cada ajuste guarda o valor anterior e "Desfazer" volta como estava.
                            Itens que dependem de você (BIOS, contas, Windows Update) abrem a tela certa ou trazem o passo a passo.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== MODO JOGO (automático + perfis do driver + cache de shaders + antes/depois) ===== -->
                <ScrollViewer x:Name="PageGameMode" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="MODO JOGO" Style="{StaticResource H1}"/>
                            <TextBlock Text="Detecta o jogo, prepara o PC sozinho e configura o driver de vídeo como os profissionais" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- Automático -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="MODO JOGO AUTOMÁTICO" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="GmStatus" Text="Desligado" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12">
                                        Quando um jogo da sua biblioteca (Steam, Epic, GOG, Ubisoft, Riot e os adicionados à mão) vai para a tela,
                                        o tHg prepara o Windows e desfaz tudo quando o jogo fecha. Cada sessão fica registrada com FPS médio e 1% low.
                                    </TextBlock>
                                    <CheckBox x:Name="GmCleanRam" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Limpar a memória em espera ao abrir o jogo" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmPower" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Plano Alto desempenho enquanto joga (exceto Ryzen X3D de dois CCDs)" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmAffinity" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock x:Name="GmAffinityText" Text="Prender o jogo nos núcleos mais rápidos para jogos" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmTimer" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Timer do Windows em 0,5 ms enquanto joga e esvaziar a memória em espera quando faltar RAM (como TimerResolution + ISLC)" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmQuiet" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Silenciar as notificações do Windows durante o jogo (Discord, WhatsApp, e-mail…); voltam ao fechar o jogo" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmProBalance" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Rebaixar programas de fundo que monopolizam a CPU durante o jogo (como o ProBalance do Process Lasso)" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmCloseApps" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Fechar OneDrive, Teams, Widgets e outros apps de fundo (lista do OTIMIZA)" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmMaxHz" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Garantir o monitor na taxa máxima (Hz) quando o jogo abre" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmSuspend" Click="GmOption_Click" Margin="0,0,0,4">
                                        <TextBlock Text="Pausar estes programas durante o jogo (voltam de onde pararam ao fechar o jogo):" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBox x:Name="GmSuspendList" Margin="28,0,0,8" LostFocus="GmOption_Click"/>
                                    <CheckBox x:Name="GmEcoQos" Click="GmOption_Click" Margin="0,0,0,8">
                                        <TextBlock Text="Modo de eficiência (EcoQoS) em navegadores, Steam/Epic e Discord enquanto o jogo roda" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GmServices" Click="GmOption_Click">
                                        <TextBlock Text="Pausar SysMain e Windows Search (leitura de disco em segundo plano) durante o jogo" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>
                                <Button ToolTip="Liga ou desliga o Modo Jogo automático (prepara o PC sozinho quando um jogo abre)" x:Name="BtnGameMode" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="LIGAR"
                                        FontSize="16" Padding="36,16" VerticalAlignment="Center" Click="BtnGameMode_Click"/>
                            </Grid>
                        </Border>

                        <!-- Tela: HDR e proteção OLED -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TELA" Style="{StaticResource Label}"/>
                                <WrapPanel>
                                    <Button ToolTip="Liga ou desliga o HDR do Windows no monitor principal" x:Name="BtnHdr" Style="{StaticResource OutlineButton}" Content="HDR" Padding="12,8" FontSize="11" Margin="0,0,8,8" Click="BtnHdr_Click"/>
                                    <Button ToolTip="Esconde a barra de tarefas sozinha para evitar marcas em telas OLED" x:Name="BtnOledBar" Style="{StaticResource OutlineButton}" Content="ESCONDER A BARRA DE TAREFAS" Padding="12,8" FontSize="11" Margin="0,0,8,8" Click="BtnOledBar_Click"/>
                                    <Button ToolTip="Desliga a tela depois de 5 minutos parado para proteger telas OLED" x:Name="BtnOledOff" Style="{StaticResource OutlineButton}" Content="DESLIGAR A TELA APÓS 5 MIN" Padding="12,8" FontSize="11" Margin="0,0,8,8" Click="BtnOledOff_Click"/>
                                    <Button ToolTip="Volta a barra de tarefas e o tempo de desligar a tela ao que eram antes" Style="{StaticResource OutlineButton}" Content="DESFAZER" Padding="12,8" FontSize="11" Margin="0,0,8,8" Click="BtnOledRestore_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="DisplayStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"
                                           Text="HDR liga e desliga em todos os monitores compatíveis (o mesmo que Win + Alt + B). Para OLED: barra de tarefas escondida e tela desligando sozinha evitam marcas de imagem parada."/>
                            </StackPanel>
                        </Border>

                        <!-- Perfis do driver -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="ProTitle" Text="PERFIS PRO NO DRIVER DE VÍDEO" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button ToolTip="Volta os perfis do driver de vídeo ao padrão" x:Name="BtnProRestore" Style="{StaticResource OutlineButton}" Content="RESTAURAR DRIVER" Padding="12,4" FontSize="11"
                                                Margin="0,0,8,0" Click="BtnProRestore_Click"/>
                                        <Button ToolTip="Aplica no driver de vídeo os perfis recomendados para os jogos competitivos" x:Name="BtnProApply" Style="{StaticResource PrimaryButton}" Content="APLICAR PERFIS PRO" Padding="16,4" FontSize="11"
                                                Click="BtnProApply_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ProIntro" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Border x:Name="AmdSnapPanel" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="APLICAR TUDO DE UMA VEZ NO AMD SOFTWARE" Style="{StaticResource Label}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                                   Text="1. No AMD Software, vá em Configurações (engrenagem) → Sistema → Configurações de instantâneo → Exportar e salve o arquivo. 2. Clique abaixo e escolha esse arquivo: o tHg cria uma cópia com os ajustes para jogos na Área de Trabalho, sem mexer em CPU, BIOS, telas e perfis. 3. No AMD Software, clique em Importar, escolha a cópia e confirme em até 15 segundos (senão ele desfaz sozinho)."/>
                                        <Button ToolTip="Lê o arquivo exportado pelo AMD Software (Adrenalin) e gera uma configuração otimizada para importar nele" x:Name="BtnAmdSnap" Style="{StaticResource PrimaryButton}" Content="GERAR CONFIGURAÇÃO PARA IMPORTAR" Padding="16,8" FontSize="11"
                                                HorizontalAlignment="Left" Click="BtnAmdSnap_Click"/>
                                        <TextBlock x:Name="AmdSnapResult" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="ProDlss" Click="ProVrr_Click" Margin="0,0,0,8">
                                    <TextBlock Text="Forçar o DLSS mais novo (modelo Transformer) nos jogos com DLSS · placas RTX" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="ProVrr" Click="ProVrr_Click" Margin="0,0,0,12">
                                    <TextBlock x:Name="ProVrrText" Text="Meu monitor tem G-SYNC / FreeSync e está ligado" TextWrapping="Wrap"/>
                                </CheckBox>
                                <ItemsControl x:Name="ProList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Faint}"
                                                                       VerticalAlignment="Center" Margin="12,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Recipe}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                               VerticalAlignment="Top" Margin="12,2,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ProResult" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Antes e depois -->
                            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="ANTES E DEPOIS DO TURBO" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="GmCompareIntro" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="GmCompare" ItemTemplate="{StaticResource Meter}"/>
                                    <Grid Margin="0,12,0,8">
                                        <TextBlock Text="ÚLTIMAS SESSÕES" Style="{StaticResource Label}"/>
                                        <Button ToolTip="Salva o histórico de sessões de jogo numa planilha (CSV)" Style="{StaticResource OutlineButton}" Content="EXPORTAR CSV" Padding="12,4" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnExportSessions_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="GmSessions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Item1}" TextTrimming="CharacterEllipsis" Margin="0,0,140,0"/>
                                                    <TextBlock Text="{Binding Item2}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Cache de shaders -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="CACHE DE SHADERS" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="ShaderSize" Style="{StaticResource Big}" Text="—" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="ShaderHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12">
                                        Os jogos guardam os shaders já compilados para não travar na próxima vez. Depois de atualizar o driver de vídeo,
                                        o cache antigo pode causar engasgos: limpe e deixe o jogo recriar (as primeiras partidas compilam de novo).
                                    </TextBlock>
                                    <Button ToolTip="Apaga o cache de shaders do driver (o jogo recria no próximo uso; feche os jogos antes)" x:Name="BtnShaderClean" Style="{StaticResource OutlineButton}" Content="LIMPAR CACHE DE SHADERS" Padding="12,8"
                                            FontSize="11" HorizontalAlignment="Left" Click="BtnShaderClean_Click"/>
                                    <TextBlock x:Name="ShaderResult" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,20"/>
                                    <TextBlock Text="GRAVAÇÃO DE FRAMETIME" Style="{StaticResource Label}"/>
                                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12">
                                        Grava 60 segundos de jogo frame a frame, como o CapFrameX: FPS médio, 1% e 0,1% low e engasgos,
                                        com o arquivo CSV em Documentos. Clique, volte para o jogo e jogue normalmente.
                                    </TextBlock>
                                    <Button ToolTip="Grava 60 segundos de frametime do jogo aberto para analisar engasgos" x:Name="BtnCapture" Style="{StaticResource PrimaryButton}" Content="GRAVAR 60 s" Padding="16,8"
                                            FontSize="12" HorizontalAlignment="Left" Click="BtnCapture_Click"/>
                                    <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <ItemsControl x:Name="CaptureList" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Line}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== DDU (remoção completa do driver de vídeo) ===== -->
                <ScrollViewer x:Name="PageDdu" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="DDU" Style="{StaticResource H1}"/>
                            <TextBlock Text="Remoção completa do driver de vídeo e instalação limpa do driver mais recente" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- 1. Placa detectada + driver novo -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="SUA PLACA DE VÍDEO" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="DduGpuName" Text="Detectando…" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border CornerRadius="10" Padding="8,4" Background="{DynamicResource Hover}" Margin="0,0,8,8">
                                            <TextBlock x:Name="DduDrvInstalled" Text="instalado: —" FontFamily="{StaticResource Mono}" FontSize="12"/>
                                        </Border>
                                        <Border x:Name="DduDrvLatestPill" CornerRadius="10" Padding="8,4" Background="{DynamicResource Hover}" Margin="0,0,8,8">
                                            <TextBlock x:Name="DduDrvLatest" Text="mais recente: verificando…" FontFamily="{StaticResource Mono}" FontSize="12"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock x:Name="DduDlStatus" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Grid x:Name="DduDlBar" Height="4" Background="{DynamicResource Line}" Margin="0,8,0,0" Visibility="Collapsed">
                                        <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="DduDlProgress" ScaleX="0"/></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <CheckBox x:Name="DduInstallAfter" IsChecked="True" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Instalar este driver sozinho depois da limpeza" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>
                                <Button ToolTip="Baixa o driver de vídeo mais novo antes da limpeza, para instalar logo depois" x:Name="BtnDduDownload" Grid.Column="1" Style="{StaticResource OutlineButton}" Content="BAIXAR DRIVER MAIS RECENTE"
                                        Padding="16,12" FontSize="12" VerticalAlignment="Center" Click="BtnDduDownload_Click"/>
                            </Grid>
                        </Border>

                        <!-- 2. Limpeza -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="O QUE REMOVER" Style="{StaticResource Label}"/>
                                    <Button ToolTip="Procura restos de drivers de vídeo antigos no PC" x:Name="BtnDduScan" Style="{StaticResource OutlineButton}" Content="ANALISAR" Padding="12,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnDduScan_Click"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,12">
                                    <TextBlock Text="VÍDEO" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,8" Width="44"/>
                                    <RadioButton x:Name="DduNvidia" Style="{StaticResource Chip}" GroupName="DduVendor" Content="NVIDIA" Tag="Nvidia" Checked="DduVendor_Checked"/>
                                    <RadioButton x:Name="DduAmd" Style="{StaticResource Chip}" GroupName="DduVendor" Content="AMD" Tag="Amd" Checked="DduVendor_Checked"/>
                                    <RadioButton x:Name="DduIntel" Style="{StaticResource Chip}" GroupName="DduVendor" Content="Intel" Tag="Intel" Checked="DduVendor_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="DduVendor" Content="Todos de vídeo" Tag="AllVideo" Checked="DduVendor_Checked"/>
                                    <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="12,0,16,8" VerticalAlignment="Center"/>
                                    <TextBlock Text="ÁUDIO" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="DduVendor" Content="Realtek" Tag="Realtek" Checked="DduVendor_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="DduVendor" Content="Sound Blaster" Tag="Creative" Checked="DduVendor_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="DduVendor" Content="Todos de áudio" Tag="AllAudio" Checked="DduVendor_Checked"/>
                                </WrapPanel>
                                <TextBlock x:Name="DduFound" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox x:Name="DduSafeMode" IsChecked="True" Margin="0,0,0,8" Click="DduSafeMode_Click">
                                            <TextBlock Text="Limpar no Modo de Segurança (recomendado)" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <CheckBox x:Name="DduRestorePoint" IsChecked="True" Margin="0,0,0,8">
                                            <TextBlock Text="Criar ponto de restauração antes" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <CheckBox x:Name="DduBackup" IsChecked="True" Margin="0,0,0,8">
                                            <TextBlock Text="Backup dos drivers em Documentos" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <CheckBox x:Name="DduBlockWu" IsChecked="True" Margin="0,0,0,8">
                                            <TextBlock Text="Impedir o Windows Update de instalar um driver sozinho" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox x:Name="DduLeftovers" IsChecked="True" Margin="0,0,0,8">
                                            <TextBlock Text="Remover serviços e pastas do painel (NVIDIA App, AMD Software, C:\NVIDIA, C:\AMD)" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <CheckBox x:Name="DduStoreApps" IsChecked="True" Margin="0,0,0,8">
                                            <TextBlock Text="Remover o painel instalado pela Microsoft Store" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <CheckBox x:Name="DduMonitors" IsChecked="True" Margin="0,0,0,8">
                                            <TextBlock Text="Remover monitores conectados e antigos (o Windows relê resolução e Hz)" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <CheckBox x:Name="DduShaders" IsChecked="True" Margin="0,0,0,8">
                                            <TextBlock Text="Limpar o cache de shaders" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button ToolTip="Remove o driver de vídeo e, no fim, reinicia no Windows normal" x:Name="BtnDduRestart" Style="{StaticResource PrimaryButton}" Content="LIMPAR E REINICIAR" Padding="20,12"
                                            FontSize="12" Margin="0,0,12,8" Tag="Restart" Click="BtnDduClean_Click"/>
                                    <Button ToolTip="Remove o driver de vídeo e, no fim, deixa o PC ligado" x:Name="BtnDduNoRestart" Style="{StaticResource OutlineButton}" Content="LIMPAR SEM REINICIAR" Padding="20,12"
                                            FontSize="12" Margin="0,0,12,8" Tag="None" Click="BtnDduClean_Click" IsEnabled="False"/>
                                    <Button ToolTip="Remove o driver de vídeo e, no fim, desliga o PC (para trocar a placa de vídeo)" x:Name="BtnDduShutdown" Style="{StaticResource OutlineButton}" Content="LIMPAR E DESLIGAR" Padding="20,12"
                                            FontSize="12" Margin="0,0,0,8" Tag="Shutdown" Click="BtnDduClean_Click"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                    Reiniciar: o normal para trocar ou reinstalar o driver. Desligar: para trocar a placa de vídeo (o PC desliga depois da limpeza).
                                    Sem reiniciar: só fora do Modo de Segurança. Na AMD e na Intel, só o que é de vídeo é removido; chipset e rede ficam. Áudio: o Windows volta com o driver de som genérico até você instalar o do fabricante.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 3. Registro -->
                        <Border Style="{StaticResource CardBorder}" Padding="24,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="REGISTRO DA LIMPEZA" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button ToolTip="Deixa o Windows Update instalar drivers de vídeo de novo" x:Name="BtnDduUnblock" Style="{StaticResource OutlineButton}" Content="LIBERAR WINDOWS UPDATE" Padding="12,4"
                                                FontSize="11" Margin="0,0,8,0" Click="BtnDduUnblock_Click"/>
                                        <Button ToolTip="Apaga os instaladores de driver baixados e já usados" Style="{StaticResource OutlineButton}" Content="APAGAR INSTALADORES" Padding="12,4"
                                                FontSize="11" Margin="0,0,8,0" Click="BtnDduCleanInstallers_Click"/>
                                        <Button ToolTip="Abre o registro da última limpeza do driver" Style="{StaticResource OutlineButton}" Content="ABRIR REGISTRO" Padding="12,4" FontSize="11" Click="BtnDduOpenLog_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DduLog" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" Text="Nenhuma limpeza feita ainda."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== TESTE DE ENGASGOS (latência de DPC/ISR por driver) ===== -->
                <ScrollViewer x:Name="PageLatency" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Teste de engasgos" Style="{StaticResource H1}"/>
                            <TextBlock Text="Mede quanto tempo cada driver segura o processador, como o LatencyMon, e aponta o culpado" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="PIOR LATÊNCIA DE DRIVER" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LatMax" Text="—" FontSize="44" FontWeight="Bold" FontFamily="{StaticResource Mono}"/>
                                        <TextBlock Text="µs" FontSize="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LatVerdict" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Até 500 µs é bom. De 500 µs a 2 ms pode causar microengasgos. Acima de 2 ms causa engasgos e estalos no áudio."/>
                                    <TextBlock x:Name="LatStatus" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button ToolTip="Mede por 60 segundos a latência de drivers (DPC/ISR) que causa engasgos" x:Name="BtnLatency" Style="{StaticResource PrimaryButton}" Content="TESTAR 60 s" FontSize="14" Padding="28,12"
                                            Click="BtnLatency_Click"/>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Width="200" Margin="0,12,0,0"
                                               Text="Para achar engasgos em jogo, deixe o jogo aberto em segundo monitor ou use o PC normalmente durante o teste."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Padding="20,8">
                            <ItemsControl x:Name="LatList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding What}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding File}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Faint}"
                                                                   VerticalAlignment="Center" Margin="12,1,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Line}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Fix}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="pill" Grid.Column="1" VerticalAlignment="Top" CornerRadius="10" Padding="8,2" Background="{DynamicResource GoodSoft}">
                                                    <TextBlock x:Name="pillText" Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Good}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="ATENÇÃO">
                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource Warn}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="RUIM">
                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource BadSoft}"/>
                                                <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource Bad}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== LIMPEZA DO WINDOWS (sem propaganda, telemetria, apps inúteis e arquivos temporários) ===== -->
                <ScrollViewer x:Name="PageClean" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Limpeza do Windows" Style="{StaticResource H1}"/>
                            <TextBlock Text="Menos coisa rodando escondida: sem Copilot, Recall, Widgets, propaganda e apps que vieram de brinde" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- Ajustes reversíveis -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="AJUSTES (TODOS COM DESFAZER)" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button ToolTip="Desfaz todos os ajustes desta página" Style="{StaticResource OutlineButton}" Content="DESFAZER TUDO" Padding="12,4" FontSize="11" Margin="0,0,8,0"
                                                Click="BtnCleanRestore_Click"/>
                                        <Button ToolTip="Aplica os ajustes recomendados (Copilot, Recall, Widgets, telemetria…)" x:Name="BtnCleanAll" Style="{StaticResource PrimaryButton}" Content="APLICAR RECOMENDADOS" Padding="12,4" FontSize="11"
                                                Click="BtnCleanAll_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Políticas do próprio Windows, as mesmas de empresas e do WinUtil. O valor de antes fica guardado e "Desfazer tudo"
                                    volta exatamente como estava. Nada aqui desliga Defender, firewall ou Windows Update.
                                </TextBlock>
                                <ItemsControl x:Name="CleanTweaks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsOn, Mode=OneWay}" Tag="{Binding}" Click="Tweak_Click"
                                                              VerticalAlignment="Top" Margin="0,1,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Effect}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Arquivos temporários -->
                            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="ARQUIVOS TEMPORÁRIOS" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="CleanTotal" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                                        Sobras que o Windows e os programas recriam se precisarem. Arquivos em uso ficam.
                                    </TextBlock>
                                    <ItemsControl x:Name="CleanTargets">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,1,12,0" Click="CleanTarget_Click"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource Mono}"
                                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button ToolTip="Apaga os arquivos temporários das categorias marcadas" x:Name="BtnCleanFiles" Style="{StaticResource PrimaryButton}" Content="LIMPAR SELECIONADOS" Padding="16,8" FontSize="12"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnCleanFiles_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Apps pré-instalados -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="APPS QUE VIERAM DE BRINDE" Style="{StaticResource Label}"/>
                                        <Button ToolTip="Reinstala da Microsoft Store os apps que o tHg removeu" x:Name="BtnAppsRestore" Style="{StaticResource OutlineButton}" Content="REINSTALAR REMOVIDOS" Padding="12,4" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnBloatRestore_Click"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                                        Removidos só da sua conta; a cópia do Windows fica, por isso dá para reinstalar. Xbox, Game Bar, Loja,
                                        Fotos e Calculadora nunca aparecem aqui.
                                    </TextBlock>
                                    <TextBlock x:Name="BloatEmpty" Foreground="{DynamicResource Muted}" Text="Procurando…" Margin="0,4,0,4"/>
                                    <ItemsControl x:Name="BloatList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}"/>
                                                            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button ToolTip="Remove da sua conta os apps marcados" x:Name="BtnBloat" Style="{StaticResource PrimaryButton}" Content="REMOVER SELECIONADOS" Padding="16,8" FontSize="12"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnBloat_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="CleanLog" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12"
                                   TextWrapping="Wrap" Margin="2,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== DIAGNÓSTICO USB (Avançado) ===== -->
                <ScrollViewer x:Name="PageUsb" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Diagnóstico USB" Style="{StaticResource H1}"/>
                            <TextBlock Text="Todos os dispositivos USB e HID com VID/PID, driver e porta COM, e o que o tHg reconhece entre eles" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="DISPOSITIVOS USB" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button ToolTip="Procura de novo os dispositivos USB conectados" Style="{StaticResource OutlineButton}" Content="PROCURAR DE NOVO" Padding="12,4" FontSize="11" Margin="0,0,8,0" Click="BtnUsbDevScan_Click"/>
                                        <Button ToolTip="Salva a lista de dispositivos USB num arquivo de texto" Style="{StaticResource PrimaryButton}" Content="SALVAR RELATÓRIO" Padding="12,4" FontSize="11" Click="BtnUsbReport_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UsbDevSummary" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBox x:Name="UsbDevText" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11" TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="260"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== FANS (curvas com histerese nas saídas da placa-mãe) ===== -->
                <ScrollViewer x:Name="PageFans" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Fans" Style="{StaticResource H1}"/>
                            <TextBlock Text="Curvas por temperatura com histerese: as fans não ficam acelerando e parando a cada pico de um segundo" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="COMPORTAMENTO" Style="{StaticResource Label}"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="Histerese (°C)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        <TextBox x:Name="FanHyst" Width="90" Margin="0,4,0,0" LostFocus="FanGlobal_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="Esperar antes de desacelerar (s)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        <TextBox x:Name="FanDelay" Width="90" Margin="0,4,0,0" LostFocus="FanGlobal_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="Subida máx. (%/s)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        <TextBox x:Name="FanRise" Width="90" Margin="0,4,0,0" LostFocus="FanGlobal_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="Descida máx. (%/s)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        <TextBox x:Name="FanFall" Width="90" Margin="0,4,0,0" LostFocus="FanGlobal_Changed"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="A fan sobe na hora quando esquenta. Para descer, a temperatura precisa cair a histerese abaixo do último pico e ficar assim pelo tempo escolhido. Segurança: sem leitura de temperatura ou com a CPU acima de 90 °C, 100%. Ao fechar o tHg, as fans voltam ao controle da BIOS."/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="FanStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="2,0,0,12"/>
                        <StackPanel x:Name="FanList"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== TELAS LCD E DIAGNÓSTICO USB ===== -->
                <ScrollViewer x:Name="PageLcd" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Telas LCD" Style="{StaticResource H1}"/>
                            <TextBlock Text="Imagem, GIF e sensores para telas de gabinete (Turzx / Turing) e fans e coolers Lian Li" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="SUAS TELAS" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Escolha a tela para configurar. Cada uma guarda a própria imagem, encaixe, sensores, brilho e rotação; mudar uma não mexe nas outras."
                                               Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                    <WrapPanel x:Name="LcdScreenCards"/>
                                    <TextBlock x:Name="LcdScreenInfo" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                    <Button ToolTip="Procura de novo as telas LCD conectadas" Style="{StaticResource OutlineButton}" Content="PROCURAR TELAS DE NOVO" Padding="12,4" FontSize="11" Margin="0,8,0,0"
                                            HorizontalAlignment="Left" Click="BtnLcdRescan_Click"/>
                                    <StackPanel x:Name="LcdTargetsBox">
                                        <TextBlock Text="Resolução do arquivo" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,4"/>
                                        <WrapPanel x:Name="LcdTargets"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LcdEditTitle" Text="IMAGEM DESTA TELA" Style="{StaticResource Label}" Margin="0,20,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button ToolTip="Escolhe a imagem ou GIF desta tela" Style="{StaticResource PrimaryButton}" Content="ESCOLHER IMAGEM OU GIF" Padding="12,8" FontSize="11" Click="BtnLcdPick_Click"/>
                                        <Button ToolTip="Tira a imagem (só as informações sobre fundo preto)" Style="{StaticResource OutlineButton}" Content="SEM IMAGEM" Padding="12,4" FontSize="11" Margin="8,0,0,0" Click="BtnLcdClear_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="Encaixe" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,4"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="LcdFill" Style="{StaticResource Chip}" GroupName="LcdFit" Content="PREENCHER (CORTA)" IsChecked="True" Checked="LcdOption_Changed"/>
                                        <RadioButton x:Name="LcdFit" Style="{StaticResource Chip}" GroupName="LcdFit" Content="CABER INTEIRA" Checked="LcdOption_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Text="Sensores por cima" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,4"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="LcdCpuT" Content="Temp. CPU" IsChecked="True" Margin="0,0,16,8" Click="LcdOption_Changed"/>
                                        <CheckBox x:Name="LcdGpuT" Content="Temp. GPU" IsChecked="True" Margin="0,0,16,8" Click="LcdOption_Changed"/>
                                        <CheckBox x:Name="LcdCpuL" Content="Uso CPU" Margin="0,0,16,8" Click="LcdOption_Changed"/>
                                        <CheckBox x:Name="LcdGpuL" Content="Uso GPU" Margin="0,0,16,8" Click="LcdOption_Changed"/>
                                        <CheckBox x:Name="LcdClock" Content="Hora" Margin="0,0,16,8" Click="LcdOption_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Text="Brilho desta tela" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,4"/>
                                    <WrapPanel x:Name="LcdBrightChips">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="LcdBright" Content="25%" Tag="25" Checked="LcdBright_Checked"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="LcdBright" Content="50%" Tag="50" Checked="LcdBright_Checked"/>
                                        <RadioButton x:Name="LcdBright75" Style="{StaticResource Chip}" GroupName="LcdBright" Content="75%" Tag="75" IsChecked="True" Checked="LcdBright_Checked"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="LcdBright" Content="100%" Tag="100" Checked="LcdBright_Checked"/>
                                    </WrapPanel>
                                    <TextBlock Text="Girar a imagem" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,4"/>
                                    <WrapPanel x:Name="LcdRotChips">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="LcdRot" Content="0°" Tag="0" IsChecked="True" Checked="LcdRot_Checked"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="LcdRot" Content="90°" Tag="90" Checked="LcdRot_Checked"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="LcdRot" Content="180°" Tag="180" Checked="LcdRot_Checked"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="LcdRot" Content="270°" Tag="270" Checked="LcdRot_Checked"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="LcdLoop" Margin="0,8,0,0" Click="LcdLoop_Click">
                                        <TextBlock Text="Atualização contínua em todas as telas (1 quadro por segundo, em segundo plano: sensores e GIF ao vivo, cada tela com o seu conteúdo)" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button ToolTip="Salva o quadro atual como imagem JPEG" Style="{StaticResource OutlineButton}" Content="SALVAR QUADRO (JPEG)" Padding="12,4" FontSize="11" Click="BtnLcdSave_Click"/>
                                        <Button ToolTip="Envia a imagem e as informações para a tela escolhida" x:Name="BtnLcdSend" Style="{StaticResource PrimaryButton}" Content="APLICAR NESTA TELA" Padding="12,8" FontSize="11" Margin="8,0,0,0"
                                                Click="BtnLcdSend_Click"/>
                                        <Button ToolTip="Envia a mesma configuração para todas as telas" x:Name="BtnLcdSendAll" Style="{StaticResource OutlineButton}" Content="APLICAR EM TODAS" Padding="12,4" FontSize="11" Margin="8,0,0,0"
                                                Click="BtnLcdSendAll_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LcdStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PRÉVIA AO VIVO" Style="{StaticResource Label}"/>
                                    <Border Width="300" Height="300" Background="Black" CornerRadius="6">
                                        <Image x:Name="LcdPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock x:Name="LcdRes" HorizontalAlignment="Center" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== INICIALIZAÇÃO (programas que abrem com o Windows) ===== -->
                <ScrollViewer x:Name="PageStartup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,192,0">
                                <TextBlock Text="INICIALIZAÇÃO" Style="{StaticResource H1}"/>
                                <TextBlock Text="Programas que abrem junto com o Windows · desative ou remova o que não precisa" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Lê de novo os programas que abrem com o Windows" Style="{StaticResource PrimaryButton}" Content="ATUALIZAR" Padding="20,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnStartupScan_Click"/>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="StartupSummary" Text="PROGRAMAS DE INICIALIZAÇÃO" Style="{StaticResource Label}"/>
                                    <Button ToolTip="Devolve à inicialização os programas removidos pelo tHg" x:Name="BtnStartupRestore" Style="{StaticResource OutlineButton}" Content="RESTAURAR REMOVIDOS" Padding="12,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnStartupRestore_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                    O interruptor ativa ou desativa na hora, do mesmo jeito que o Gerenciador de Tarefas (a entrada continua
                                    lá e pode ser religada). REMOVER apaga a entrada da inicialização; o programa continua instalado e
                                    dá para desfazer em "Restaurar removidos". Vale na próxima vez que o Windows iniciar.
                                </TextBlock>
                                <ItemsControl x:Name="StartupList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="StartupToggle_Click"
                                                              VerticalAlignment="Top" Margin="0,1,12,0" ToolTip="Ativar / desativar na inicialização"/>
                                                    <StackPanel Grid.Column="1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,152,0"/>
                                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Command}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Command}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button ToolTip="Tira este programa da inicialização do Windows" Grid.Column="2" Style="{StaticResource OutlineButton}" Content="REMOVER" Padding="12,4" FontSize="11"
                                                            Tag="{Binding}" Click="StartupRemove_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="StartupResult" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== INSTALAR APPS (pós-formatação, via winget) ===== -->
                <ScrollViewer x:Name="PageApps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,252,0">
                                <TextBlock Text="INSTALAR APPS" Style="{StaticResource H1}"/>
                                <TextBlock Text="Os essenciais depois de formatar o PC · versão oficial mais recente, instalação silenciosa" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Instala pelo winget os apps marcados" x:Name="BtnAppsInstall" Style="{StaticResource PrimaryButton}" Content="INSTALAR SELECIONADOS" Padding="20,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnAppsInstall_Click"/>
                        </Grid>
                        <Grid Height="3" Margin="0,0,0,8" Background="{DynamicResource Line}">
                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="AppsProgress" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="AppsStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="APPS" Style="{StaticResource Label}"/>
                                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button ToolTip="Marca todos os apps da lista" Style="{StaticResource OutlineButton}" Content="MARCAR TODOS" Padding="12,4" FontSize="11" Margin="0,0,8,0" Click="BtnAppsAll_Click"/>
                                        <Button ToolTip="Desmarca todos os apps" Style="{StaticResource OutlineButton}" Content="DESMARCAR" Padding="12,4" FontSize="11" Click="BtnAppsNone_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Usa o winget, o instalador de pacotes da Microsoft que já vem no Windows 10/11: baixa do site oficial de
                                    cada fabricante e confere o arquivo antes de instalar. Os apps são instalados um de cada vez, sem janelas.
                                    O que já está instalado aparece marcado como INSTALADO.
                                </TextBlock>
                                <ItemsControl x:Name="AppsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                               VerticalAlignment="Top" Margin="16,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value=""/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                                                        <Setter Property="Text" Value="INSTALADO"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button ToolTip="Atualiza o Instalador de Aplicativo (winget) pela Microsoft Store" x:Name="BtnAppsStore" Style="{StaticResource OutlineButton}" Content="ATUALIZAR O INSTALADOR DE APLICATIVO (MICROSOFT STORE)"
                                        Padding="16,8" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnAppsStore_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== MAKER · Portas COM (fantasmas e números COM presos) ===== -->
                <ScrollViewer x:Name="PageMakerPorts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="PORTAS COM" Style="{StaticResource H1}"/>
                            <TextBlock Text="Arduino, ESP32 e conversores seriais · remova dispositivos fantasmas e libere números COM presos" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="USB E PORTAS COM (ARDUINO, ESP32, CONVERSORES SERIAIS)" Style="{StaticResource Label}"/>
                                    <Button ToolTip="Procura dispositivos USB desconectados que ficaram registrados" Style="{StaticResource OutlineButton}" Content="PROCURAR" Padding="12,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnUsbScan_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Cada placa plugada numa porta USB diferente vira um registro novo e prende um número COM. Os registros
                                    de dispositivos que não estão conectados ("fantasmas") confundem a IDE do Arduino e empurram a porta
                                    para COM20+. Remover um fantasma é seguro: ao plugar de novo, o Windows reinstala na hora.
                                </TextBlock>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CONECTADOS AGORA" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="UsbConnected" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="NÚMEROS COM RESERVADOS" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="UsbComDb" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UsbSummary" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="UsbList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding InstanceId}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button ToolTip="Apaga do Windows os registros de dispositivos desconectados marcados" x:Name="BtnUsbRemove" Style="{StaticResource PrimaryButton}" Content="REMOVER SELECIONADOS"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnUsbRemove_Click"/>
                                    <Button ToolTip="Libera números de porta COM reservados por dispositivos que não existem mais" Style="{StaticResource OutlineButton}" Content="LIBERAR NÚMEROS COM PRESOS"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnComDb_Click"/>
                                    <Button ToolTip="Volta as reservas de porta COM como estavam" x:Name="BtnComDbRestore" Style="{StaticResource OutlineButton}" Content="DESFAZER LIBERAÇÃO"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnComDbRestore_Click"/>
                                    <CheckBox x:Name="UsbShowAll" Content="Mostrar todos os ausentes (não só portas COM e placas)"
                                              VerticalAlignment="Center" Margin="8,0,0,8" Checked="UsbShowAll_Changed" Unchecked="UsbShowAll_Changed"/>
                                </WrapPanel>
                                <TextBlock x:Name="UsbResult" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== MAKER · Drivers seriais (CH340, CP210x, FTDI, Prolific, Arduino) ===== -->
                <ScrollViewer x:Name="PageMakerDrv" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,192,0">
                                <TextBlock Text="DRIVERS SERIAIS" Style="{StaticResource H1}"/>
                                <TextBlock Text="CH340 · CP2102/CP210x · FTDI · Prolific · Arduino — diagnóstico, reinstalação e troca de versão do driver" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button ToolTip="Verifica os drivers seriais (CH340, CP210x, FTDI, Prolific) instalados" x:Name="BtnMakerScan" Style="{StaticResource PrimaryButton}" Content="VERIFICAR" Padding="20,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnMakerScan_Click"/>
                        </Grid>
                        <TextBlock x:Name="MakerStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Conectados agora -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PLACAS E CONVERSORES CONECTADOS" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MakerNoDevices" Text="Nenhuma placa ou conversor serial conectado. Plugue a placa e clique em VERIFICAR."
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <ItemsControl x:Name="MakerDevices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,112,0"/>
                                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,1,0,0">
                                                            <Run Text="Driver: "/><Run Text="{Binding Driver, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Advice}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                                        <Button ToolTip="Reinstala este driver serial" Style="{StaticResource OutlineButton}" Content="REINSTALAR" Padding="12,4" FontSize="11" Margin="0,0,0,8"
                                                                Tag="{Binding}" Click="MakerReinstall_Click"/>
                                                        <Button ToolTip="Abre a página oficial do fabricante deste chip" Style="{StaticResource OutlineButton}" Content="PÁGINA OFICIAL" Padding="12,4" FontSize="11"
                                                                Tag="{Binding Chip}" Click="MakerOfficial_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0">
                                    REINSTALAR remove o dispositivo e pede ao Windows para detectar de novo, com o melhor driver disponível
                                    (resolve a maioria dos códigos 10 e 43). Placa que não aparece nenhuma vez: troque o cabo, muitos são só de carga.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Drivers oficiais embutidos no app -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="DRIVERS INCLUÍDOS" Style="{StaticResource Label}"/>
                                    <Button ToolTip="Instala todos os drivers seriais que vêm com o tHg" x:Name="BtnMakerBundleAll" Style="{StaticResource OutlineButton}" Content="INSTALAR TODOS" Padding="12,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnMakerBundleAll_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Drivers oficiais de cada fabricante que já vêm dentro do tHg Optimization: instalam sem internet, ideal logo depois
                                    de formatar. Pode instalar com a placa desconectada; o Windows usa o driver quando ela for plugada.
                                    Os drivers Arduino são assinados pela Arduino (não pela Microsoft): o Windows pode pedir confirmação.
                                </TextBlock>
                                <ItemsControl x:Name="MakerBundled">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,100,0"/>
                                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                                    </StackPanel>
                                                    <Button ToolTip="Instala este driver serial que vem com o tHg" Grid.Column="1" Style="{StaticResource OutlineButton}" Content="INSTALAR" Padding="12,4" FontSize="11"
                                                            Tag="{Binding}" Click="MakerInstallBundled_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Pacotes de driver -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="DRIVERS INSTALADOS NO WINDOWS" Style="{StaticResource Label}"/>
                                    <Button ToolTip="Devolve ao Windows os drivers seriais removidos" x:Name="BtnMakerRestore" Style="{StaticResource OutlineButton}" Content="RESTAURAR REMOVIDOS" Padding="12,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnMakerRestore_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Versões guardadas no Windows para cada chip, da mais nova para a mais antiga. Quando a versão nova não funciona
                                    com a sua placa (clones de CH340, FTDI ou PL2303 falsificados), remova-a: o Windows passa a usar a anterior.
                                    Para desinstalar o driver de vez, remova todas as versões daquele chip. Cada remoção faz backup antes.
                                </TextBlock>
                                <TextBlock x:Name="MakerNoPackages" Text="Nenhum driver de chip serial instalado além dos do próprio Windows."
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <ItemsControl x:Name="MakerPackages">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                                    </StackPanel>
                                                    <Button ToolTip="Remove este pacote de driver do Windows" Grid.Column="1" Style="{StaticResource OutlineButton}" Content="REMOVER" Padding="12,4" FontSize="11"
                                                            Tag="{Binding}" Click="MakerRemovePackage_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Arduino IDE -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="ARDUINO IDE" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MakerIde" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MakerHolders" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button ToolTip="Baixa e instala (ou atualiza) a Arduino IDE" x:Name="BtnMakerIde" Style="{StaticResource OutlineButton}" Content="INSTALAR / ATUALIZAR A IDE"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnMakerIde_Click"/>
                                    <Button ToolTip="Fecha os programas que estão usando a porta serial" Style="{StaticResource OutlineButton}" Content="FECHAR PROGRAMAS QUE PRENDEM A PORTA"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnMakerHolders_Click"/>
                                    <Button ToolTip="Apaga o cache da Arduino IDE (resolve compilações travadas)" Style="{StaticResource OutlineButton}" Content="LIMPAR CACHE DA IDE"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnMakerCache_Click"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                                    "Porta ocupada" / "Access denied" no upload: outro programa está com a porta aberta (monitor serial,
                                    Cura, PuTTY...). IDE travada em "Downloading index" ou erro ao instalar placas: limpe o cache (as placas e
                                    bibliotecas instaladas continuam). A instalação da IDE também instala os drivers das placas Arduino oficiais.
                                </TextBlock>
                                <TextBlock x:Name="MakerIdeResult" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== OC ===== -->
                <ScrollViewer x:Name="PageOc" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="OC" Style="{StaticResource H1}"/>
                            <TextBlock Text="Ajustes da GPU, verificador de estabilidade e guia de overclock na BIOS" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- GPU: limite de energia e teto de clock -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="OcGpuTitle" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OcGpuState" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <Grid>
                                    <TextBlock Text="LIMITE DE ENERGIA" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="OcPowerValue" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="OcPower" Minimum="175" Maximum="300" Value="250" TickFrequency="5"
                                        IsSnapToTickEnabled="True" ValueChanged="OcPower_Changed"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16">
                                    Mais energia = clocks mais altos sustentados (e mais calor). Menos energia = PC mais frio e silencioso.
                                </TextBlock>

                                <TextBlock Text="TETO DE CLOCK (UNDERVOLT)" Style="{StaticResource Label}"/>
                                <WrapPanel x:Name="OcClockPanel" Margin="0,4,0,0"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16">
                                    Limitar o clock máximo faz a placa usar menos tensão: costuma perder 1–3% de FPS e economizar bastante
                                    energia e calor. "Sem teto" é o comportamento normal.
                                </TextBlock>

                                <WrapPanel>
                                    <Button ToolTip="Aplica o limite de energia e o teto de clock na placa de vídeo" x:Name="BtnOcApply" Style="{StaticResource PrimaryButton}" Content="APLICAR"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnOcApply_Click"/>
                                    <Button ToolTip="Volta a placa de vídeo para o limite e os clocks de fábrica" Style="{StaticResource OutlineButton}" Content="RESTAURAR PADRÃO"
                                            Padding="20,8" Margin="0,0,12,8" Click="BtnOcReset_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="OcGpuResult" TextWrapping="Wrap"/>
                                <StackPanel x:Name="OcProfiles" Margin="0,12,0,0"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                    Ajustes temporários: voltam ao padrão ao reiniciar o PC. Usa só os controles oficiais do driver NVIDIA (NVML);
                                    offset de clock/memória não é liberado por essa via no Windows.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Verificador de estabilidade -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="VERIFICADOR DE ESTABILIDADE" Style="{StaticResource Label}"/>
                                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Depois de mudar algo (aqui ou na BIOS): mede a nota, roda stress, vigia temperatura e procura erros de
                                    hardware (WHEA) e reinícios do driver de vídeo no registro do Windows.
                                </TextBlock>

                                <TextBlock Text="CONFIGURAÇÃO TESTADA" Style="{StaticResource Label}"/>
                                <TextBox x:Name="OcLabel" Tag="ex.: PBO + Curve Optimizer -15, GPU 220 W" Margin="0,0,0,12"/>

                                <WrapPanel>
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="TESTAR" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="OcTargetPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcTarget" Content="CPU + RAM" Tag="cpu" Margin="0,0,8,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcTarget" Content="GPU" Tag="gpu" Margin="0,0,8,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcTarget" Content="Ambos" Tag="both" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="OcDurPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcDur" Content="5 min" Tag="5" Margin="0,0,8,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcDur" Content="15 min" Tag="15" Margin="0,0,8,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcDur" Content="30 min" Tag="30" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>

                                <Button ToolTip="Verifica se o overclock está estável" x:Name="BtnOcCheck" Style="{StaticResource PrimaryButton}" Content="INICIAR VERIFICAÇÃO"
                                        HorizontalAlignment="Left" Padding="24,12" Margin="0,16,0,0" Click="BtnOcCheck_Click"/>

                                <Grid Height="4" Margin="0,12,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="OcProgress" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="OcStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

                                <Border x:Name="OcVerdictCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}"
                                        BorderThickness="1" Padding="16,12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="OcVerdict" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="OcVerdictWhy" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <ItemsControl x:Name="OcResult">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Opacity="0.7" Margin="0,0,16,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}"
                                                                   HorizontalAlignment="Right" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="ERROS DE HARDWARE RECENTES" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                                <TextBlock x:Name="OcRecentErrors" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

                                <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                                <ItemsControl x:Name="OcHistory" ItemTemplate="{StaticResource Meter}"/>
                            </StackPanel>
                        </Border>

                        <!-- Guia de overclock na BIOS -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="OcGuideTitle" Text="GUIA: OVERCLOCK NA BIOS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OcGuideIntro" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <ItemsControl x:Name="OcGuide">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                                        VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Number}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Where}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== STRESS TEST ===== -->
                <Grid x:Name="PageStress" Margin="{StaticResource PagePadding}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="140"/>
                        <RowDefinition Height="110"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Stress test" Style="{StaticResource H1}"/>
                        <TextBlock Text="Carga máxima com corte automático por temperatura" Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <!-- Configuração -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Linha 1: geral + CPU/RAM -->
                            <WrapPanel>
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock Text="COMPONENTES" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" Height="30">
                                        <CheckBox x:Name="ChkCpu" Content="CPU" IsChecked="True" Margin="0,0,20,0"/>
                                        <CheckBox x:Name="ChkRam" Content="RAM" Checked="ChkRam_Click" Unchecked="ChkRam_Click" Margin="0,0,20,0"/>
                                        <CheckBox x:Name="ChkGpu" Content="GPU" Checked="ChkGpu_Click" Unchecked="ChkGpu_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock Text="USO DA RAM LIVRE" Style="{StaticResource Label}"/>
                                    <StackPanel x:Name="RamFractionPanel" Orientation="Horizontal" IsEnabled="False">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="Ram" Content="40%" Tag="0.4" Margin="0,0,8,0"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="Ram" Content="60%" Tag="0.6" Margin="0,0,8,0" IsChecked="True"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="Ram" Content="80%" Tag="0.8" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="LIMITE CPU °C" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TempLimit" Text="90" Width="80"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="LIMITE GPU °C" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="GpuTempLimit" Text="85" Width="80" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="DURAÇÃO (MIN)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtDuration" Text="10" Width="80" Tag="0 = ∞"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Linha 2: GPU (estilo FurMark) -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                                <WrapPanel x:Name="GpuOptions" IsEnabled="False">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="GPU · RESOLUÇÃO" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="GpuResPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="720p" Tag="1280x720" Margin="0,0,8,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="1080p" Tag="1920x1080" Margin="0,0,8,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="1440p" Tag="2560x1440" Margin="0,0,8,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="Tela cheia" Tag="full" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="ANTI-ALIASING" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="GpuMsaaPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuMsaa" Content="Off" Tag="1" Margin="0,0,8,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuMsaa" Content="4x MSAA" Tag="4" Margin="0,0,8,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuMsaa" Content="8x MSAA" Tag="8" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="INTENSIDADE" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="GpuIntensityPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuInt" Content="Normal" Tag="96,32" Margin="0,0,8,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuInt" Content="Alta" Tag="128,48" Margin="0,0,8,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuInt" Content="Extrema" Tag="160,64" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button ToolTip="Inicia o stress test com as opções escolhidas" x:Name="BtnStress" Style="{StaticResource PrimaryButton}" Content="INICIAR"
                                        MinWidth="150" Click="BtnStress_Click"/>
                                <TextBlock x:Name="StressHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12"
                                           MaxWidth="220" Margin="0,12,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Leituras -->
                    <UniformGrid Grid.Row="2" Columns="8" Margin="-4,0,-4,16">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                <Setter Property="Margin" Value="4,0"/>
                                <Setter Property="Padding" Value="16"/>
                            </Style>
                            <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Big}">
                                <Setter Property="FontSize" Value="20"/>
                            </Style>
                            <Style x:Key="StatSub" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </UniformGrid.Resources>
                        <Border x:Name="StatusCard">
                            <StackPanel>
                                <TextBlock x:Name="StStatusLabel" Text="STATUS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StStatus" Text="Parado" Style="{StaticResource StatValue}" FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TEMPO" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StElapsed" Text="00:00:00" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TEMP. CPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StTemp" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StTempMax" Text="máx. —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="CONSUMO CPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StPower" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StLoad" Text="carga —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TEMP. GPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StGpuTemp" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StGpuTempMax" Text="máx. —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="CONSUMO GPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StGpuPower" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StGpuCap" Text="—" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="FPS (GPU)" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StFps" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StFpsAvg" Text="média —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StRam" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="passes / erros" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Gráfico -->
                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20,16,20,12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="TEMPERATURAS — ÚLTIMOS 5 MIN" Style="{StaticResource Label}" Margin="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                    <Line X1="0" X2="14" Stroke="{DynamicResource Muted}" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="limites" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="TempChart" ClipToBounds="True" SizeChanged="TempChart_SizeChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- Log -->
                    <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="20,16,12,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="REGISTRO" Style="{StaticResource Label}"/>
                            <ListBox x:Name="StressLog" FontFamily="{StaticResource Mono}" FontSize="12"
                                     Foreground="{DynamicResource Muted}" ItemContainerStyle="{StaticResource PlainItem}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
