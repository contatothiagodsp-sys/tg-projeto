<UserControl x:Class="ThgOptimization.Views.FrametimeCompareChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Bg}" Padding="12">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Rectangle x:Name="LegendSwatchA" Width="14" Height="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="LegendA" Foreground="{DynamicResource Fg}" Margin="0,0,16,0"/>
            <Rectangle x:Name="LegendSwatchB" Width="14" Height="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="LegendB" Foreground="{DynamicResource Fg}" Margin="0,0,16,0"/>
            <TextBlock Text="frametime em ms · mais alto é melhor · pontilhado: P99 e P99,9" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Canvas x:Name="Plot" ClipToBounds="True"/>
            <TextBlock x:Name="NoData" Foreground="{DynamicResource Muted}" Visibility="Collapsed" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Arquivo da captura não encontrado em Documentos: só os números estão disponíveis."/>
        </Grid>
        <StackPanel x:Name="Numbers" Grid.Column="2" Grid.RowSpan="2"/>
    </Grid>
    </Border>
</UserControl>
