<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SDK do Windows para as APIs WinRT (Iluminação Dinâmica / LampArray); continua rodando a partir do Windows 10 1809 -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <!-- Avisos de nulidade viram erro: o projeto está em 0 e não deve voltar a acumular -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>tHgOptimization</AssemblyName>
    <RootNamespace>ThgOptimization</RootNamespace>
    <Product>tHg Optimization</Product>
    <Company>tHg</Company>
    <Description>tHg Optimization: desempenho, segurança e diagnóstico para PC gamer</Description>
    <!-- Única fonte da versão: app, rodapé, Configurações, atualizador, instalador e release saem deste número, sem nenhum outro.
         O CI não numera nada: para publicar, mude este número e crie a seção dele no CHANGELOG. Sem mudar, o push não gera release. -->

    <Version>1.7.4</Version>
    <!-- Sem o hash do commit: as propriedades do .exe mostram o mesmo número do app. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Sempre otimizado: o RESET BENCH e os stress tests precisam do JIT otimizado também em Debug -->
    <Optimize>true</Optimize>
    <!-- TieredPGO e a compilação em camadas já são o padrão do .NET 8; ficam explícitos para ninguém desligar sem querer.
         ReadyToRun (PublishReadyToRun) foi medido: +38% no .exe (225 → 312 MB), por isso fica de fora. -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Atualização pelo app: o GitHub Actions passa -p:UpdateRepo=dono/repo (o do próprio repositório, inclusive em forks).
       Builds locais usam o repositório oficial, para quem instalar uma cópia gerada no PC também receber as versões novas. -->
  <PropertyGroup>
    <UpdateRepo Condition="'$(UpdateRepo)' == ''">contatothiagodsp-sys/tg-projeto</UpdateRepo>
  </PropertyGroup>
  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <!-- O projeto de testes fica em tests\: o glob padrão do SDK (**/*.cs, **/*.xaml) não pode compilá-lo junto com o app. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Page Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <InternalsVisibleTo Include="ThgOptimization.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-badge.png" />
    <Resource Include="Assets\thg-wordmark.png" />
    <Resource Include="Assets\thg-wordmark-dark.png" />
    <Resource Include="Assets\Fonts\Rajdhani-SemiBold.ttf" />
  </ItemGroup>

  <!-- Drivers seriais oficiais embutidos (RESET MAKER): cada pasta Drivers\<chip> vira recurso e é extraída na hora de instalar.
       Para incluir outro, basta criar a pasta com o .inf/.cat/.sys e ligá-la em MakerDrivers.Chips (Bundle). -->
  <ItemGroup>
    <EmbeddedResource Include="Drivers\**\*" Exclude="Drivers\*.md;Drivers\*.txt" LogicalName="Drivers/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- iCUE SDK da Corsair (RESET INTEGRAÇÃO): se a DLL estiver em Native\, ela vai junto do .exe. Não é versionada no git. -->
  <ItemGroup>
    <None Include="Native\iCUESDK.x64_2019.dll" Condition="Exists('Native\iCUESDK.x64_2019.dll')" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Polly.Core" Version="8.4.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

</Project>
